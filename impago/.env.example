# ╔══════════════════════════════════════════════╗
# ║  ImpaGo API — Configuração de Ambiente       ║
# ╚══════════════════════════════════════════════╝

# Porta do servidor HTTP
IMPAGO_PORT=8080

# Chave mestra para rotas administrativas (OBRIGATÓRIO)
# Gere com: openssl rand -hex 32
IMPAGO_MASTER_KEY=sua-chave-mestra-aqui

# URL de conexão PostgreSQL (OBRIGATÓRIO)
IMPAGO_DATABASE_URL=postgres://impago:impago@localhost:5432/impago?sslmode=disable

# Nível de log: trace, debug, info, warn, error, fatal
IMPAGO_LOG_LEVEL=info

# Log formatado colorido (development)
IMPAGO_LOG_PRETTY=true

# Ambiente: development, production
IMPAGO_ENVIRONMENT=development

# CORS — origens permitidas (separadas por vírgula)
IMPAGO_CORS_ORIGINS=*

# Webhook global — todas as conexões enviam eventos para esta URL
IMPAGO_WEBHOOK_GLOBAL_URL=

# Secret enviado no header X-Webhook-Secret
IMPAGO_WEBHOOK_SECRET=
