# ============================================
# Stage 1: Build da aplicação React
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ============================================
# Stage 2: Nginx servindo arquivos estáticos
# ============================================
FROM nginx:alpine

# Remove config padrão do nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copia os arquivos buildados do Vite
COPY --from=builder /app/dist /usr/share/nginx/html

# Copia o template do nginx (envsubst automático pela imagem oficial)
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Variáveis de ambiente configuráveis em runtime (sem rebuild!)
# BACKEND_HOST = nome do serviço do backend na rede Docker
# BACKEND_PORT = porta do backend
ENV BACKEND_HOST=crm_backend
ENV BACKEND_PORT=3333

EXPOSE 80
