  regexCue             String?
  description          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, attributeKey, attributeModel])
