// ══════════════════════════════════════════════════════════
// ─── PLANOS E LIMITES ────────────────────────────────────────
// ══════════════════════════════════════════════════════════

model Plan {
  id          String  @id @default(uuid())
  name        String // "Gratuito", "Básico", "Pro", "Enterprise"
  slug        String  @unique // "free", "basic", "pro", "enterprise"
  description String?
  price       Float   @default(0)
  isDefault   Boolean @default(false) // Plano atribuído a novas empresas
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  limits    PlanLimit[]
  companies Company[]

  @@map("plans")
}

model PlanLimit {
  id         String @id @default(uuid())
  planId     String
  featureKey String // "maxUsers", "maxInstances", "maxContacts", etc.
  limitValue Int // -1 = ilimitado, 0 = bloqueado, N = limite numérico

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_limits")
}

// ============================================
// Conversation Events (Activity Log)
// ============================================

model ConversationEvent {
  id             String   @id @default(uuid())
  conversationId String
  instanceId     String
  remoteJid      String
  eventType      String // "ai_session_started", "status_changed", "custom_field_set", etc.
  description    String // Texto legível: "IA começou a atender", "Thiago alterou CPF para 123..."
  actorType      String // "ai", "user", "system"
  actorName      String? // Nome do agente IA ou do usuário
  metadata       Json? // Dados extras (campo anterior, novo valor, etc.)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([instanceId, remoteJid, createdAt])
  @@map("conversation_events")
}

// ══════════════════════════════════════════════
// ═══ PIPELINE / KANBAN ═══
// ══════════════════════════════════════════════

enum CardStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum CardPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  STAGE_CHANGED
  ASSIGNED
  NOTE_ADDED
  TASK_COMPLETED
  FILE_UPLOADED
  VALUE_CHANGED
  FIELD_CHANGED
  CONTACT_LINKED
  STATUS_CHANGED
  CARD_CREATED
  CUSTOM
}

model Pipeline {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  type        String   @default("sales") // sales, support, onboarding, custom, legal, etc.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  color       String?
  position    Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages  Stage[]
  cards   Card[]

  @@index([companyId, isActive])
  @@map("pipelines")
}

model Stage {
  id          String   @id @default(uuid())
  pipelineId  String
  companyId   String
  name        String
  slug        String // slug único dentro do pipeline (ex: "audiencia")
  color       String   @default("#6366f1")
  position    Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  rottingDays Int? // dias até card "apodrecer"
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@unique([pipelineId, slug])
  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model Card {
  id                String       @id @default(uuid())
  pipelineId        String
  stageId           String
  companyId         String
  contactId         String?
  conversationId    String?
  title             String
  description       String?
  value             Decimal?     @db.Decimal(15, 2)
  currency          String       @default("BRL")
  assigneeId        String?
  teamId            String?
  position          Int          @default(0)
  priority          CardPriority @default(NONE)
  status            CardStatus   @default(OPEN)
  source            String? // web, import, manual, whatsapp, automation
  expectedCloseDate DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  customFields      Json? // campos flexíveis {key: value}
  metadata          Json?
  createdBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        Stage         @relation(fields: [stageId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team         Team?         @relation("CardTeam", fields: [teamId], references: [id], onDelete: SetNull)

  activities CardActivity[]
  tasks      CardTask[]
  notes      CardNote[]
  files      CardFile[]
  tags       CardTag[]
  proposals  Proposal[]     @relation("ProposalOpportunity")
  tickets    Ticket[]

  @@index([pipelineId, stageId, position])
  @@index([companyId, status])
  @@index([contactId])
  @@index([assigneeId])
  @@map("pipeline_cards")
}

model CardActivity {
  id        String       @id @default(uuid())
  cardId    String
  type      ActivityType
  content   String?
  actorId   String?
  actorType String       @default("user") // user, system, ai, automation
  actorName String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime     @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@map("pipeline_card_activities")
}

model CardTask {
  id          String       @id @default(uuid())
  cardId      String
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  priority    CardPriority @default(NONE)
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  completedBy String?
  position    Int          @default(0)
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  card     Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([cardId, isCompleted])
  @@map("pipeline_card_tasks")
}

model CardNote {
  id        String   @id @default(uuid())
  cardId    String
  content   String
  isPrivate Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User? @relation("NoteAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@map("pipeline_card_notes")
}

model CardFile {
  id         String   @id @default(uuid())
  cardId     String
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  card     Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User? @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@map("pipeline_card_files")
}

model CardTag {
  id      String @id @default(uuid())
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([cardId, labelId])
  @@map("pipeline_card_tags")
}

// ══════════════════════════════════════════
// ─── SISTEMA DE MÓDULOS NATIVOS ──────────
// ══════════════════════════════════════════

model CrmModule {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyModules CompanyModule[]

  @@map("crm_modules")
}

model CompanyModule {
  id          String   @id @default(uuid())
  companyId   String
  moduleId    String
  isActive    Boolean  @default(true)
  config      Json?
  activatedAt DateTime @default(now())
  activatedBy String?

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  CrmModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@index([companyId, isActive])
  @@map("company_modules")
}

// ════════════════════════════════════════════════════════════
// ─── AGENDAMENTO DE MENSAGENS ──────────────────────────────
// ════════════════════════════════════════════════════════════

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ERROR
}

enum ScheduleRecurrence {
  ONCE // Envio único
  DAILY // Todos os dias
  EVERY_X_DAYS // A cada X dias
  WEEKLY // Toda semana
  SPECIFIC_DAYS // Dias específicos da semana
  MONTHLY // Mensalmente
}

model ScheduledMessage {
  id         String  @id @default(uuid())
  companyId  String
  instanceId String
  contactId  String? // Contato alvo (opcional se for grupo)
  remoteJid  String // JID do destinatário

  // Conteúdo
  name          String // Nome identificador do agendamento
  messageType   String  @default("text") // text, image, video, audio, document
  content       String? // Texto ou legenda
  mediaUrl      String? // URL da mídia (se aplicável)
  mediaFileName String? // Nome original do arquivo

  // Agendamento
  status          ScheduleStatus     @default(ACTIVE)
  recurrence      ScheduleRecurrence @default(ONCE)
  timezone        String             @default("America/Sao_Paulo")
  scheduledAt     DateTime // Data/hora do primeiro envio
  recurrenceRule  Json? // Regras extras: { intervalDays?, weekDays?, dayOfMonth?, endDate?, maxOccurrences? }
  nextExecutionAt DateTime? // Próxima execução calculada
  lastExecutedAt  DateTime? // Última execução

  // IA para personalização (opcional)
  aiEnabled    Boolean @default(false)
  aiProviderId String? // Provider de IA a usar
  aiModel      String? // Modelo específico
  aiPrompt     String? // Mini-prompt para reescrita

  // Contadores
  totalSent      Int     @default(0)
  totalFailed    Int     @default(0)
  maxOccurrences Int? // Limite de envios (null = indefinido)
  errorMessage   String? // Último erro

  // Auditoria
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance   Instance              @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact    Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy  User                  @relation("scheduledMessagesCreated", fields: [createdById], references: [id])
  aiProvider AIProvider?           @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  logs       ScheduledMessageLog[]

  @@index([companyId, status])
  @@index([nextExecutionAt, status])
  @@index([instanceId])
  @@map("scheduled_messages")
}

model ScheduledMessageLog {
  id                 String   @id @default(uuid())
  scheduledMessageId String
  status             String // SENT, FAILED
  content            String? // Conteúdo efetivamente enviado (pode ter sido alterado pela IA)
  messageId          String? // ID da mensagem enviada
  error              String?
  aiUsed             Boolean  @default(false)
  executedAt         DateTime @default(now())

  scheduledMessage ScheduledMessage @relation(fields: [scheduledMessageId], references: [id], onDelete: Cascade)

  @@index([scheduledMessageId])
  @@index([executedAt])
  @@map("scheduled_message_logs")
}

// ════════════════════════════════════════════════════════════
// ─── CRM COMERCIAL / FINANCEIRO / OPERAÇÃO ─────────────────
// ════════════════════════════════════════════════════════════

// ── Organização (empresa do CLIENTE, PJ) ────────────────────

model Organization {
  id             String  @id @default(uuid())
  companyId      String
  name           String
  tradeName      String?
  document       String? // CNPJ
  email          String?
  phone          String?
  website        String?
  address        Json?
  billingAddress Json?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts         Contact[]
  customerAccounts CustomerAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("organizations")
}

// ── Conta Cliente ───────────────────────────────────────────

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum CustomerAccountContactRole {
  PRIMARY
  BILLING
  DECISION_MAKER
  OPERATIONAL
  MEMBER
}

model CustomerAccount {
  id             String      @id @default(uuid())
  companyId      String
  organizationId String?
  accountType    AccountType @default(INDIVIDUAL)

  billingName     String?
  billingEmail    String?
  billingAddress  Json?
  shippingAddress Json?
  taxId           String?
  creditLimit     Decimal? @db.Decimal(15, 2)
  paymentTermDays Int?     @default(30)

  status          CustomerStatus @default(ACTIVE)
  firstPurchaseAt DateTime?
  lastPurchaseAt  DateTime?
  totalSpent      Decimal?       @default(0) @db.Decimal(15, 2)

  notes        String?
  customFields Json?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization Organization?            @relation(fields: [organizationId], references: [id])
  members      CustomerAccountContact[]
  activityLogs CustomerActivityLog[]

  @@index([companyId, status])
  @@map("customer_accounts")
}

model CustomerAccountContact {
  id                String                     @id @default(uuid())
  customerAccountId String
  contactId         String
  role              CustomerAccountContactRole @default(MEMBER)
  isPrimary         Boolean                    @default(false)
  createdAt         DateTime                   @default(now())

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, contactId])
  @@map("customer_account_contacts")
}

// ── Customer Activity Log ───────────────────────────────────

model CustomerActivityLog {
  id                String   @id @default(uuid())
  companyId         String
  customerAccountId String
  contactId         String?
  userId            String?
  action            String // Ex: CREATED, UPDATED, STATUS_CHANGED, CONTACT_ADDED, PROPOSAL_CREATED, CONTRACT_SIGNED, AI_STARTED, AI_STOPPED, LABEL_ADDED, MESSAGE_SENT...
  entity            String? // Ex: proposal, invoice, contract, project, task, label, ai, message...
  entityId          String?
  description       String // Descrição legível: "Proposta #PRO-001 criada", "Etiqueta 'VIP' adicionada"
  oldValue          String?
  newValue          String?
  metadata          Json? // Dados extras (snapshot, valores, etc.)
  createdAt         DateTime @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, createdAt])
  @@index([companyId, createdAt])
  @@map("customer_activity_logs")
}

// ── Lead Profile ────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFYING
  QUALIFIED
  UNQUALIFIED
  DISQUALIFIED
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

model LeadProfile {
  id        String @id @default(uuid())
  companyId String
  contactId String @unique

  status      LeadStatus      @default(NEW)
  temperature LeadTemperature @default(COLD)
  score       Int?
  source      String?
  channel     String?

  qualifiedAt        DateTime?
  qualificationNotes String?
  disqualifiedAt     DateTime?
  disqualifiedReason String?

  estimatedBudget Decimal? @db.Decimal(15, 2)
  budgetCurrency  String?  @default("BRL")

  assignedTo    String?
  convertedAt   DateTime?
  opportunityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("lead_profiles")
}

// ════════════════════════════════════════════════════════════
// ─── CATÁLOGO DE PRODUTOS/SERVIÇOS ─────────────────────────
// ════════════════════════════════════════════════════════════

enum ItemType {
  PRODUCT
  SERVICE
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

model ItemCategory {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  icon        String?
  color       String?
  position    Int     @default(0)

  parentId String?
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")

  items CatalogItem[]

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@map("item_categories")
}

model CatalogItem {
  id        String   @id @default(uuid())
  companyId String
  name      String
  slug      String
  type      ItemType @default(SERVICE)

  categoryId String?

  description     String?
  longDescription String?

  pitch       String?
  benefits    Json?
  features    Json?
  faq         Json?
  useCases    String?
  testimonial String?

  price    Decimal @db.Decimal(15, 2)
  currency String  @default("BRL")
  unit     String?

  billingCycle BillingCycle @default(ONE_TIME)

  taxRate Decimal? @db.Decimal(5, 2)
  sku     String?
  barcode String?

  active   Boolean @default(true)
  featured Boolean @default(false)
  position Int     @default(0)

  customFields    Json?
  qdrantIndexedAt DateTime?

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ItemCategory?    @relation(fields: [categoryId], references: [id])
  variants      ItemVariant[]
  images        ItemImage[]
  priceTiers    ItemPriceTier[]
  bundles       ItemBundleItem[]
  proposalItems ProposalItem[]
  invoiceItems  InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, active])
  @@index([companyId, categoryId])
  @@map("catalog_items")
}

model ItemVariant {
  id           String        @id @default(uuid())
  itemId       String
  name         String
  sku          String?
  price        Decimal       @db.Decimal(15, 2)
  currency     String        @default("BRL")
  billingCycle BillingCycle?
  description  String?
  attributes   Json?
  active       Boolean       @default(true)
  position     Int           @default(0)

  item          CatalogItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  images        ItemImage[]
  priceTiers    ItemPriceTier[]
  proposalItems ProposalItem[]
  invoiceItems  InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("item_variants")
}

model ItemImage {
  id        String  @id @default(uuid())
  itemId    String
  variantId String?
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  item    CatalogItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("item_images")
}

model ItemPriceTier {
  id          String  @id @default(uuid())
  itemId      String
  variantId   String?
  minQuantity Int
  maxQuantity Int?
  price       Decimal @db.Decimal(15, 2)

  item    CatalogItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("item_price_tiers")
}

enum BundlePricingType {
  FIXED
  DISCOUNT
}

model ItemBundle {
  id              String            @id @default(uuid())
  companyId       String
  name            String
  slug            String
  description     String?
  pitch           String?
  pricingType     BundlePricingType @default(FIXED)
  fixedPrice      Decimal?          @db.Decimal(15, 2)
  discountPercent Decimal?          @db.Decimal(5, 2)
  currency        String            @default("BRL")
  billingCycle    BillingCycle      @default(ONE_TIME)
  imageUrl        String?
  active          Boolean           @default(true)
  featured        Boolean           @default(false)

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items         ItemBundleItem[]
  proposalItems ProposalItem[]
  invoiceItems  InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@map("item_bundles")
}

model ItemBundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  itemId    String
  variantId String?
  quantity  Decimal @default(1) @db.Decimal(15, 4)
  position  Int     @default(0)

  bundle ItemBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  item   CatalogItem @relation(fields: [itemId], references: [id])

  @@unique([bundleId, itemId, variantId])
  @@map("item_bundle_items")
}

// ════════════════════════════════════════════════════════════
// ─── PROPOSTAS (Proposal + Estimate) ───────────────────────
// ════════════════════════════════════════════════════════════

enum ProposalType {
  PROPOSAL
  ESTIMATE
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  REVISED
}

model Proposal {
  id            String       @id @default(uuid())
  companyId     String
  number        Int
  prefix        String?      @default("PROP-")
  type          ProposalType @default(PROPOSAL)
  contactId     String
  opportunityId String?
  title         String
  content       String?

  subtotal        Decimal  @default(0) @db.Decimal(15, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(15, 2)
  discountType    String?
  taxTotal        Decimal  @default(0) @db.Decimal(15, 2)
  adjustment      Decimal? @db.Decimal(15, 2)
  total           Decimal  @default(0) @db.Decimal(15, 2)
  currency        String   @default("BRL")

  date       DateTime  @default(now())
  validUntil DateTime?

  status     ProposalStatus @default(DRAFT)
  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  signatureFile   String?
  acceptanceName  String?
  acceptanceEmail String?
  acceptanceIp    String?

  hash String @unique @default(uuid())

  assignedTo String?
  createdBy  String

  convertedAt DateTime?

  terms        String?
  clientNote   String?
  internalNote String?

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact            @relation(fields: [contactId], references: [id])
  opportunity Card?              @relation("ProposalOpportunity", fields: [opportunityId], references: [id])
  items       ProposalItem[]
  comments    ProposalComment[]
  activities  ProposalActivity[]
  invoice     Invoice?
  contracts   Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, prefix, number])
  @@map("proposals")
}

model ProposalItem {
  id         String  @id @default(uuid())
  proposalId String
  itemId     String?
  variantId  String?
  bundleId   String?

  description     String
  longDescription String?
  quantity        Decimal       @default(1) @db.Decimal(15, 4)
  unit            String?
  rate            Decimal       @db.Decimal(15, 2)
  taxRate         Decimal?      @db.Decimal(5, 2)
  taxAmount       Decimal?      @db.Decimal(15, 2)
  discount        Decimal?      @db.Decimal(15, 2)
  total           Decimal       @db.Decimal(15, 2)
  sortOrder       Int           @default(0)
  isOptional      Boolean       @default(false)
  isSelected      Boolean       @default(true)
  billingCycle    BillingCycle?

  proposal Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  item     CatalogItem? @relation(fields: [itemId], references: [id])
  variant  ItemVariant? @relation(fields: [variantId], references: [id])
  bundle   ItemBundle?  @relation(fields: [bundleId], references: [id])

  @@map("proposal_items")
}

model ProposalComment {
  id         String   @id @default(uuid())
  proposalId String
  content    String
  authorId   String?
  authorName String?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_comments")
}

model ProposalActivity {
  id         String   @id @default(uuid())
  proposalId String
  type       String
  content    String?
  actorId    String?
  actorType  String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_activities")
}

// ════════════════════════════════════════════════════════════
// ─── FATURAS ───────────────────────────────────────────────
// ════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id         String  @id @default(uuid())
  companyId  String
  number     Int
  prefix     String? @default("FAT-")
  contactId  String
  proposalId String? @unique
  projectId  String?

  subtotal        Decimal  @default(0) @db.Decimal(15, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(15, 2)
  discountType    String?
  taxTotal        Decimal  @default(0) @db.Decimal(15, 2)
  adjustment      Decimal? @db.Decimal(15, 2)
  total           Decimal  @default(0) @db.Decimal(15, 2)
  amountPaid      Decimal  @default(0) @db.Decimal(15, 2)
  amountDue       Decimal  @default(0) @db.Decimal(15, 2)
  currency        String   @default("BRL")

  date    DateTime  @default(now())
  dueDate DateTime?

  status InvoiceStatus @default(DRAFT)
  sentAt DateTime?
  paidAt DateTime?

  isRecurring         Boolean   @default(false)
  recurringType       String?
  recurringEvery      Int?
  recurringCycles     Int?
  recurringCyclesDone Int?      @default(0)
  recurringFromId     String?
  lastRecurringDate   DateTime?

  hash String @unique @default(uuid())

  billingAddress  Json?
  shippingAddress Json?

  terms        String?
  clientNote   String?
  internalNote String?

  assignedTo String?
  createdBy  String

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact           @relation(fields: [contactId], references: [id])
  proposal    Proposal?         @relation(fields: [proposalId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  activities  InvoiceActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, prefix, number])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  itemId    String?
  variantId String?
  bundleId  String?

  description     String
  longDescription String?
  quantity        Decimal       @default(1) @db.Decimal(15, 4)
  unit            String?
  rate            Decimal       @db.Decimal(15, 2)
  taxRate         Decimal?      @db.Decimal(5, 2)
  taxAmount       Decimal?      @db.Decimal(15, 2)
  discount        Decimal?      @db.Decimal(15, 2)
  total           Decimal       @db.Decimal(15, 2)
  sortOrder       Int           @default(0)
  billingCycle    BillingCycle?

  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    CatalogItem? @relation(fields: [itemId], references: [id])
  variant ItemVariant? @relation(fields: [variantId], references: [id])
  bundle  ItemBundle?  @relation(fields: [bundleId], references: [id])

  @@map("invoice_items")
}

model InvoiceActivity {
  id        String   @id @default(uuid())
  invoiceId String
  type      String
  content   String?
  actorId   String?
  actorType String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("invoice_activities")
}

// ════════════════════════════════════════════════════════════
// ─── PAGAMENTOS ────────────────────────────────────────────
// ════════════════════════════════════════════════════════════

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  PARTIAL_REFUND
}

model Payment {
  id        String        @id @default(uuid())
  companyId String
  invoiceId String
  amount    Decimal       @db.Decimal(15, 2)
  method    PaymentMethod
  date      DateTime      @default(now())

  gateway        String?
  transactionId  String?
  gatewayFee     Decimal? @db.Decimal(15, 2)
  externalStatus String?
  webhookPayload Json?

  status       PaymentStatus @default(PENDING)
  confirmedAt  DateTime?
  failedAt     DateTime?
  failedReason String?

  refundAmount Decimal?  @db.Decimal(15, 2)
  refundedAt   DateTime?
  refundReason String?

  note        String?
  receiptFile String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([companyId, status])
  @@map("payments")
}

model CreditNote {
  id              String           @id @default(uuid())
  companyId       String
  number          Int
  contactId       String
  invoiceId       String?
  amount          Decimal          @db.Decimal(15, 2)
  amountUsed      Decimal          @default(0) @db.Decimal(15, 2)
  amountRemaining Decimal          @db.Decimal(15, 2)
  status          CreditNoteStatus @default(OPEN)
  reason          String?
  note            String?

  createdBy String
  createdAt DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("credit_notes")
}

enum CreditNoteStatus {
  OPEN
  APPLIED
  VOID
}

// ════════════════════════════════════════════════════════════
// ─── GATEWAY DE PAGAMENTO (modular) ───────────────────────
// ════════════════════════════════════════════════════════════

model PaymentGatewayConfig {
  id          String  @id @default(uuid())
  companyId   String
  gateway     String
  displayName String
  active      Boolean @default(true)
  sandbox     Boolean @default(false)

  credentials     Json
  enabledMethods  PaymentMethod[]
  minAmounts      Json?
  maxInstallments Int?            @default(12)

  interestRate Decimal? @db.Decimal(5, 2)
  fineRate     Decimal? @db.Decimal(5, 2)
  discountDays Int?
  discountRate Decimal? @db.Decimal(5, 2)

  webhookUrl    String?
  webhookSecret String?
  ipWhitelist   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers     GatewayCustomer[]
  webhookEvents PaymentWebhookEvent[]

  @@unique([companyId, gateway, sandbox])
  @@map("payment_gateway_configs")
}

model GatewayCustomer {
  id              String   @id @default(uuid())
  companyId       String
  gatewayConfigId String
  contactId       String
  externalId      String
  externalData    Json?
  syncedAt        DateTime @default(now())

  gatewayConfig PaymentGatewayConfig @relation(fields: [gatewayConfigId], references: [id])
  contact       Contact              @relation(fields: [contactId], references: [id])

  @@unique([gatewayConfigId, contactId])
  @@unique([gatewayConfigId, externalId])
  @@map("gateway_customers")
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model PaymentWebhookEvent {
  id              String @id @default(uuid())
  companyId       String
  gatewayConfigId String
  gateway         String
  gatewayEventId  String
  eventType       String

  payload Json

  status       PaymentWebhookEventStatus @default(RECEIVED)
  processedAt  DateTime?
  errorMessage String?
  retryCount   Int                       @default(0)

  paymentId String?
  invoiceId String?

  receivedAt DateTime @default(now())

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gatewayConfig PaymentGatewayConfig @relation(fields: [gatewayConfigId], references: [id])

  @@unique([gateway, gatewayEventId])
  @@index([companyId, gateway, eventType])
  @@map("payment_webhook_events")
}

// ════════════════════════════════════════════════════════════
// ─── DESPESAS ──────────────────────────────────────────────
// ════════════════════════════════════════════════════════════

model Expense {
  id            String         @id @default(uuid())
  companyId     String
  name          String
  amount        Decimal        @db.Decimal(15, 2)
  categoryId    String?
  contactId     String?
  projectId     String?
  date          DateTime
  paymentMethod PaymentMethod?
  currency      String         @default("BRL")
  taxRate       Decimal?       @db.Decimal(5, 2)
  note          String?
  receiptFile   String?

  billable  Boolean   @default(false)
  invoiceId String?
  billedAt  DateTime?

  isRecurring         Boolean   @default(false)
  recurringType       String?
  recurringEvery      Int?
  recurringCycles     Int?
  recurringCyclesDone Int?      @default(0)
  recurringFromId     String?
  lastRecurringDate   DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@index([companyId])
  @@map("expenses")
}

model ExpenseCategory {
  id        String  @id @default(uuid())
  companyId String
  name      String
  color     String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, name])
  @@map("expense_categories")
}

// ════════════════════════════════════════════════════════════
// ─── CONTRATOS ─────────────────────────────────────────────
// ════════════════════════════════════════════════════════════

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRING
  EXPIRED
  RENEWED
  CANCELLED
}

model Contract {
  id          String   @id @default(uuid())
  companyId   String
  number      Int
  prefix      String?  @default("CONT-")
  contactId   String
  proposalId  String?
  title       String
  description String?
  content     String?
  value       Decimal? @db.Decimal(15, 2)
  typeId      String?

  startDate DateTime
  endDate   DateTime?

  status   ContractStatus @default(DRAFT)
  signedAt DateTime?

  signatureFile String?
  signedByName  String?
  signedByEmail String?
  signedByIp    String?

  hash String @unique @default(uuid())

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact            @relation(fields: [contactId], references: [id])
  proposal   Proposal?          @relation(fields: [proposalId], references: [id])
  renewals   ContractRenewal[]
  projects   Project[]
  tasks      Task[]
  activities ContractActivity[]

  @@unique([companyId, prefix, number])
  @@map("contracts")
}

model ContractRenewal {
  id           String    @id @default(uuid())
  contractId   String
  oldStartDate DateTime
  oldEndDate   DateTime?
  oldValue     Decimal?  @db.Decimal(15, 2)
  newStartDate DateTime
  newEndDate   DateTime?
  newValue     Decimal?  @db.Decimal(15, 2)
  renewedBy    String
  renewedAt    DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_renewals")
}

model ContractActivity {
  id         String   @id @default(uuid())
  contractId String
  type       String
  content    String?
  actorId    String?
  actorType  String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@map("contract_activities")
}

model ContractTemplate {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  category    String
  description String?
  icon        String? @default("📄")
  content     String
  isDefault   Boolean @default(false)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contract_templates")
}

// ════════════════════════════════════════════════════════════
// ─── PROJETOS ──────────────────────────────────────────────
// ════════════════════════════════════════════════════════════

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectBillingType {
  FIXED
  HOURLY
  FREE
}

model Project {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  description String?
  contactId   String?
  contractId  String?

  status ProjectStatus @default(NOT_STARTED)

  billingType ProjectBillingType @default(FIXED)
  fixedCost   Decimal?           @db.Decimal(15, 2)
  hourlyRate  Decimal?           @db.Decimal(15, 2)

  progressMode String @default("auto")
  progress     Int    @default(0)

  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?

  templateId String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?            @relation(fields: [contactId], references: [id])
  contract    Contract?           @relation(fields: [contractId], references: [id])
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
  invoices    Invoice[]
  activities  ProjectActivity[]
  discussions ProjectDiscussion[]
  notes       ProjectNote[]
  timesheets  ProjectTimesheet[]

  @@index([companyId, status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String?
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  color       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  createdAt DateTime @default(now())

  @@map("milestones")
}

model ProjectActivity {
  id        String   @id @default(uuid())
  projectId String
  type      String
  content   String?
  actorId   String?
  actorType String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_activities")
}

model ProjectDiscussion {
  id             String   @id @default(uuid())
  projectId      String
  subject        String
  description    String?
  createdBy      String
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments ProjectDiscussionComment[]

  @@index([projectId])
  @@map("project_discussions")
}

model ProjectDiscussionComment {
  id           String   @id @default(uuid())
  discussionId String
  parentId     String?
  content      String
  authorId     String
  authorName   String?
  fileName     String?
  fileUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion ProjectDiscussion          @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent     ProjectDiscussionComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    ProjectDiscussionComment[] @relation("CommentReplies")

  @@index([discussionId, createdAt])
  @@map("project_discussion_comments")
}

model ProjectNote {
  id        String   @id @default(uuid())
  projectId String
  title     String
  content   String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdBy])
  @@map("project_notes")
}

model ProjectTimesheet {
  id        String    @id @default(uuid())
  projectId String
  taskId    String?
  userId    String
  startTime DateTime
  endTime   DateTime?
  duration  Int?
  note      String?
  tags      String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@map("project_timesheets")
}

// ════════════════════════════════════════════════════════════
// ─── TAREFAS ───────────────────────────────────────────────
// ════════════════════════════════════════════════════════════

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_FEEDBACK
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  description String?

  status   TaskStatus   @default(NOT_STARTED)
  priority TaskPriority @default(MEDIUM)

  projectId      String?
  milestoneId    String?
  contractId     String?
  contactId      String?
  conversationId String?
  opportunityId  String?

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  assignees TaskAssignee[]

  checklist   Json?
  timeTracked Int   @default(0)

  isRecurring    Boolean @default(false)
  recurringType  String?
  recurringEvery Int?

  billable  Boolean @default(false)
  invoiceId String?

  kanbanOrder Int     @default(0)
  isPublic    Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id])
  contract     Contract?     @relation(fields: [contractId], references: [id])
  contact      Contact?      @relation("TaskContact", fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([companyId, status])
  @@index([projectId])
  @@map("tasks")
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignees")
}

// ════════════════════════════════════════════════════════════
// ─── DOCUMENT ENGINE ───────────────────────────────────────
// ════════════════════════════════════════════════════════════

model DocumentCounter {
  id           String @id @default(uuid())
  companyId    String
  documentType String
  prefix       String
  lastNumber   Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, prefix])
  @@map("document_counters")
}

// ════════════════════════════════════════════════════════════
// ─── CHANNEL SETTINGS ──────────────────────────────────────
// ════════════════════════════════════════════════════════════

model InstanceMember {
  id         String   @id @default(uuid())
  instanceId String
  userId     String
  createdAt  DateTime @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId])
  @@map("instance_members")
}

model WorkingHour {
  id           String   @id @default(uuid())
  instanceId   String
  dayOfWeek    Int // 0=Dom, 1=Seg, 2=Ter, 3=Qua, 4=Qui, 5=Sex, 6=Sab
  openHour     Int      @default(9) // 0-23
  openMinutes  Int      @default(0) // 0-59
  closeHour    Int      @default(18) // 0-23
  closeMinutes Int      @default(0) // 0-59
  closedAllDay Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, dayOfWeek])
  @@index([instanceId])
  @@map("working_hours")
}

model CsatSurveyResponse {
  id              String   @id @default(uuid())
  instanceId      String
  conversationId  String
  contactId       String
  assignedAgentId String? // Agente que estava atendendo quando resolveu
  rating          Int // 1-5
  feedbackMessage String? // Comentário livre do contato
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instance      Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAgent User?        @relation("CsatAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  @@unique([conversationId]) // Apenas 1 CSAT por conversa
  @@index([instanceId])
  @@index([assignedAgentId])
  @@map("csat_survey_responses")
}

// ════════════════════════════════════════════════════════════
// ─── WORKFLOW ENGINE (Automações visuais avançadas) ─────────
// ════════════════════════════════════════════════════════════

enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum WorkflowTriggerType {
  MANUAL // Disparado manualmente
  CONVERSATION_OPENED // Nova conversa criada
  CONVERSATION_RESOLVED // Conversa resolvida
  MESSAGE_RECEIVED // Mensagem recebida (com filtros)
  CONTACT_CREATED // Novo contato
  CONTACT_UPDATED // Contato atualizado
  CARD_MOVED // Card movido no kanban
  LEAD_CREATED // Novo lead
  SCHEDULE // Cron/agendamento (ex: "0 9 * * 1" = toda segunda 9h)
  WEBHOOK // Webhook externo
}

model Workflow {
  id            String              @id @default(uuid())
  companyId     String
  name          String
  description   String?
  status        WorkflowStatus      @default(DRAFT)
  triggerType   WorkflowTriggerType @default(MANUAL)
  triggerConfig Json? // Filtros do trigger (ex: instanceId, keywords, cron expression)
  variables     Json? // Variáveis globais do workflow { name, type, defaultValue }[]
  settings      Json? // { maxExecutionTime, retryOnError, logLevel }
  version       Int                 @default(1)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  nodes     WorkflowNode[]
  edges     WorkflowEdge[]
  runs      WorkflowRun[]

  @@index([companyId, status])
  @@index([triggerType])
  @@map("workflows")
}

enum WorkflowNodeType {
  // Controle
  START // Entrada — recebe variáveis do trigger
  END // Saída — encerra workflow

  // IA
  LLM // Chama provider de IA (gerar texto, classificar, extrair)
  AI_AGENT // Delega para um AIAgent existente
  KNOWLEDGE_RETRIEVAL // Busca na base de conhecimento (RAG)

  // Lógica
  IF_ELSE // Condição com branches true/false
  SWITCH // Múltiplas condições (case/default)
  LOOP // Iteração sobre lista
  WAIT // Aguardar tempo ou evento

  // Dados
  SET_VARIABLE // Definir/transformar variável
  CODE // JavaScript customizado (sandbox)
  TEMPLATE // Template com Mustache/handlebars
  HTTP_REQUEST // Chamada HTTP externa

  // CRM
  SEND_MESSAGE // Enviar mensagem WhatsApp
  UPDATE_CONTACT // Atualizar dados do contato
  ASSIGN_CONVERSATION // Atribuir conversa a usuário/equipe
  ADD_TAG // Adicionar tag/label
  MOVE_CARD // Mover card no pipeline
  CREATE_TASK // Criar tarefa
  SEND_NOTIFICATION // Notificar usuário interno
}

model WorkflowNode {
  id         String           @id @default(uuid())
  workflowId String
  type       WorkflowNodeType
  label      String?
  positionX  Float            @default(0)
  positionY  Float            @default(0)
  data       Json // Config específica do tipo de node
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  workflow    Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceEdges WorkflowEdge[]          @relation("WfSourceNode")
  targetEdges WorkflowEdge[]          @relation("WfTargetNode")
  executions  WorkflowNodeExecution[]

  @@index([workflowId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id           String  @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  sourceHandle String? // "true", "false", "case_0", "default", "loop_body", "loop_done"
  targetHandle String?
  label        String?
  condition    Json? // Condição adicional para seguir esta edge

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode WorkflowNode @relation("WfSourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode WorkflowNode @relation("WfTargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_edges")
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

model WorkflowRun {
  id           String              @id @default(uuid())
  workflowId   String
  companyId    String
  status       WorkflowRunStatus   @default(RUNNING)
  triggerType  WorkflowTriggerType
  triggerData  Json? // Dados do trigger (contactId, conversationId, etc.)
  variables    Json? // Snapshot das variáveis durante execução
  outputs      Json? // Saídas finais
  error        String?
  totalTokens  Int                 @default(0)
  totalCostUsd Float               @default(0)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())

  workflow       Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeExecutions WorkflowNodeExecution[]

  @@index([workflowId])
  @@index([companyId, status])
  @@map("workflow_runs")
}

enum WorkflowNodeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model WorkflowNodeExecution {
  id         String                      @id @default(uuid())
  runId      String
  nodeId     String
  nodeType   WorkflowNodeType
  status     WorkflowNodeExecutionStatus @default(PENDING)
  inputs     Json? // Dados de entrada do node
  outputs    Json? // Dados de saída do node
  error      String?
  tokens     Int                         @default(0)
  costUsd    Float                       @default(0)
  durationMs Int                         @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime                    @default(now())

  run  WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([nodeId])
  @@map("workflow_node_executions")
}

// ─── TICKETS INTERNOS ─────────────────────────────────

enum TicketStatus {
  NOVO
  EM_ANDAMENTO
  AGUARDANDO
  RESOLVIDO
  FECHADO
  CANCELADO
}

enum TicketPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TicketCategory {
  BUG
  MELHORIA
  SUPORTE
  INFRAESTRUTURA
  FINANCEIRO
  COMERCIAL
  OUTRO
}

model Ticket {
  id          String         @id @default(uuid())
  companyId   String
  code        String // TK-001, TK-002, etc. (gerado auto)
  title       String
  description String?        @db.Text
  status      TicketStatus   @default(NOVO)
  priority    TicketPriority @default(MEDIA)
  category    TicketCategory @default(OUTRO)

  createdById String
  assigneeId  String?
  teamId      String?

  // Contexto opcional: vincular a conversa, contato, card
  conversationId String?
  contactId      String?
  cardId         String?

  dueDate    DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?
  tags       String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  team         Team?           @relation(fields: [teamId], references: [id])
  conversation Conversation?   @relation(fields: [conversationId], references: [id])
  contact      Contact?        @relation(fields: [contactId], references: [id])
  card         Card?           @relation(fields: [cardId], references: [id])
  comments     TicketComment[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, assigneeId])
  @@index([companyId, createdById])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  content    String   @db.Text
  isInternal Boolean  @default(false) // nota interna vs comentário visível
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

// ─── GOAL CASCADE (OKR) ─────────────────────────────────

enum GoalStatus {
  NAO_INICIADO
  EM_PROGRESSO
  CONCLUIDO
  CANCELADO
  ATRASADO
}

enum GoalType {
  OBJETIVO // Objective (O)
  RESULTADO_CHAVE // Key Result (KR)
  INICIATIVA // Initiative / Task
}

enum GoalMetricType {
  PERCENTUAL // 0-100%
  NUMERICO // valor numérico livre
  MONETARIO // R$
  BINARIO // feito/não feito
}

model Goal {
  id          String     @id @default(uuid())
  companyId   String
  parentId    String? // hierarquia: Objetivo → KR → Iniciativa
  title       String
  description String?    @db.Text
  type        GoalType   @default(OBJETIVO)
  status      GoalStatus @default(NAO_INICIADO)
  ownerId     String

  // Métricas
  metricType   GoalMetricType @default(PERCENTUAL)
  targetValue  Decimal        @default(100) @db.Decimal(15, 2)
  currentValue Decimal        @default(0) @db.Decimal(15, 2)
  startValue   Decimal        @default(0) @db.Decimal(15, 2)

  // Período
  startDate DateTime?
  endDate   DateTime?

  // Peso para cálculo de progresso do pai
  weight Decimal @default(1) @db.Decimal(5, 2)

  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner    User          @relation("GoalOwner", fields: [ownerId], references: [id])
  parent   Goal?         @relation("GoalHierarchy", fields: [parentId], references: [id])
  children Goal[]        @relation("GoalHierarchy")
  checkins GoalCheckin[]

  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([parentId])
  @@map("goals")
}

model GoalCheckin {
  id        String   @id @default(uuid())
  goalId    String
  value     Decimal  @db.Decimal(15, 2) // novo valor registrado
  note      String?  @db.Text
  authorId  String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_checkins")
}

// ════════════════════════════════════════════════════════════
// ─── AI BRAIN (Perfil 360° + Grafo vetorizado) ────────────
// ════════════════════════════════════════════════════════════

enum AIBrainNodeType {
  CONTACT
  COMPANY
  TOPIC
  FACT
  PREFERENCE
  OBJECTION
  EVENT
  DOCUMENT_CHUNK
  SESSION
}

enum AIBrainEdgeType {
  MENTIONS
  PREFERS
  OBJECTS_TO
  RELATED_TO
  WORKS_AT
  DEAL_OF
  LEARNED_FROM
  SUPERSEDES
  PARTICIPATED_IN
  DERIVED_FROM
}

enum AIBrainFactCategory {
  DEMOGRAPHIC
  PREFERENCE
  OBJECTION
  INTENT
  PAIN_POINT
  COMMITMENT
  EVENT
  CUSTOM
}

model AIBrainNode {
  id          String          @id @default(uuid())
  companyId   String
  agentId     String?
  type        AIBrainNodeType
  subjectType String? // ex: "contact" | "customerAccount" | "deal" | "topic" | "session"
  subjectId   String? // FK lógica para entidade do CRM
  label       String
  summary     String?         @db.Text
  metadata    Json?
  embeddingId String? // id no Qdrant (payload node_type=BRAIN_NODE)
  firstSeenAt DateTime        @default(now())
  lastSeenAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  edgesOut AIBrainEdge[] @relation("BrainEdgeFrom")
  edgesIn  AIBrainEdge[] @relation("BrainEdgeTo")
  facts    AIBrainFact[]

  @@index([companyId, type])
  @@index([companyId, subjectType, subjectId])
  @@index([companyId, lastSeenAt])
  @@map("ai_brain_nodes")
}

model AIBrainEdge {
  id               String          @id @default(uuid())
  companyId        String
  fromId           String
  toId             String
  type             AIBrainEdgeType
  weight           Float           @default(1.0)
  validFrom        DateTime        @default(now())
  validTo          DateTime?
  sourceSessionId  String?
  sourceMessageId  String?
  sourceDocumentId String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  from    AIBrainNode @relation("BrainEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to      AIBrainNode @relation("BrainEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([companyId, fromId, type])
  @@index([companyId, toId, type])
  @@index([companyId, validTo])
  @@map("ai_brain_edges")
}

model AIBrainFact {
  id                String              @id @default(uuid())
  companyId         String
  contactId         String?
  customerAccountId String?
  agentId           String?
  nodeId            String?
  category          AIBrainFactCategory
  subject           String // sujeito legível (ex: "João Silva")
  predicate         String // verbo (ex: "prefere", "objeta")
  value             String              @db.Text
  confidence        Float               @default(0.7)
  sourceType        String // "LLM" | "MANUAL" | "CRM_SYNC" | "RAG"
  sourceRefType     String? // "session" | "message" | "document" | "manual"
  sourceRefId       String?
  validFrom         DateTime            @default(now())
  validTo           DateTime?
  supersededById    String?             @unique
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  node         AIBrainNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  supersededBy AIBrainFact? @relation("FactSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   AIBrainFact? @relation("FactSupersedes")

  @@index([companyId, contactId, category])
  @@index([companyId, customerAccountId, category])
  @@index([companyId, validTo])
  @@index([nodeId])
  @@map("ai_brain_facts")
}

// ============================================
// AI Daily Brain Digest
// Auditoria/idempot�ncia do job noturno que vetoriza o hist�rico do dia
// ============================================

enum AIDailyDigestStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model AIDailyDigest {
  id        String @id @default(uuid())
  companyId String
  date      String // YYYY-MM-DD na timezone da empresa

  status     AIDailyDigestStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?

  // M�tricas
  contactsProcessed    Int @default(0)
  messagesProcessed    Int @default(0)
  conversationsTouched Int @default(0)
  cardsTouched         Int @default(0)
  tasksTouched         Int @default(0)
  ticketsTouched       Int @default(0)
  factsCreated         Int @default(0)
  embeddingsGenerated  Int @default(0)
  tokensUsed           Int @default(0)

  // Resultado
  summary      String? @db.Text // Resumo executivo do dia
  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, status])
  @@index([date])
  @@map("ai_daily_digests")
}

// ════════════════════════════════════════════════════════════════
// IMPA FLEET — Time de funcionários AI internos do CRM
// ════════════════════════════════════════════════════════════════

enum FleetMemberStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FleetMissionStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FleetMissionExecutionMode {
  AUTONOMOUS // Executa sozinho até o fim
  REQUIRE_APPROVAL // Prepara plano e aguarda aprovação humana
}

enum FleetOperationStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum FleetOperationTrigger {
  SCHEDULED
  MANUAL
  CHAT
}

enum FleetMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

/// Setor / departamento (agrupamento visual de membros)
model FleetDepartment {
  id          String  @id @default(uuid())
  companyId   String
  name        String // ex: "Comercial", "Suporte", "Operações"
  description String?
  icon        String? // lucide icon name
  color       String? // hex
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members FleetMember[]

  @@index([companyId, order])
  @@map("fleet_departments")
}

/// Membro da Fleet — funcionário AI 100% interno do CRM (independente de AIAgent/WhatsApp)
model FleetMember {
  id           String  @id @default(uuid())
  companyId    String
  departmentId String?

  // Identidade do funcionário
  name        String // "Marina", "Carlos", "Ana" — nome humano
  displayRole String // "Assistente Comercial", "Analista de Dados", etc
  avatarUrl   String?
  emoji       String?
  colorTag    String?

  // ─── CÉREBRO PRÓPRIO (não usa AIAgent) ───
  providerId   String // FK para AIProvider (reusa as credenciais já cadastradas)
  model        String // ex: gpt-4o-mini, claude-sonnet-4-5, etc
  systemPrompt String @db.Text // personalidade + missão do funcionário
  temperature  Float  @default(0.7)
  maxTokens    Int    @default(2000)
  topP         Float?
  /// Configuração de quais ferramentas internas do CRM o membro pode usar.
  /// Ex: { "fleet_admin": { "enabledTools": ["list_contacts","create_lead",...] } }
  toolsConfig  Json   @default("{}")

  // Sandbox real via RBAC — Role que o membro "assume" ao agir
  assignedRoleId String?

  status FleetMemberStatus @default(ACTIVE)

  // Comportamento
  allowAutonomousActions Boolean  @default(true)
  notificationUserIds    String[] @default([])

  /// Onboarding conversacional (estilo Hermes/OpenClaw)
  /// false = membro recém-criado, ainda configurando personalidade via chat
  /// true  = membro pronto para uso normal
  onboarded Boolean @default(false)

  // Métricas agregadas
  totalChats      Int       @default(0)
  totalMissions   Int       @default(0)
  totalOperations Int       @default(0)
  totalTokensUsed BigInt    @default(0)
  lastUsedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider   AIProvider       @relation("FleetMemberProvider", fields: [providerId], references: [id], onDelete: Restrict)
  department FleetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       Role?            @relation("FleetMemberRole", fields: [assignedRoleId], references: [id], onDelete: SetNull)

  missions      FleetMission[]
  operations    FleetOperation[]
  chats         FleetChat[]
  memoryEntries FleetMemoryEntry[]

  @@index([companyId, status])
  @@index([departmentId])
  @@index([providerId])
  @@map("fleet_members")
}

/// Missão — tarefa agendada (cron) ou única (runOnceAt) atribuída a um membro
model FleetMission {
  id        String @id @default(uuid())
  companyId String
  memberId  String

  title       String
  description String?
  // Instrução em linguagem natural — o agente interpreta e executa
  instruction String  @db.Text

  // Agendamento
  cronExpr       String? // "0 9 * * 1-5"
  cronTimezone   String?   @default("America/Sao_Paulo")
  cronNlOriginal String? // "todo dia útil às 9h" (texto original do usuário)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  runOnceAt      DateTime? // se preenchido, roda 1x e arquiva

  status        FleetMissionStatus        @default(ACTIVE)
  executionMode FleetMissionExecutionMode @default(AUTONOMOUS)

  // Limites
  maxRuns     Int?
  totalRuns   Int  @default(0)
  successRuns Int  @default(0)
  failedRuns  Int  @default(0)

  // Notificação
  notifyOnSuccess Boolean  @default(false)
  notifyOnFailure Boolean  @default(true)
  notifyUserIds   String[] @default([])

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member     FleetMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  creator    User?            @relation("FleetMissionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  operations FleetOperation[]

  @@index([companyId, status])
  @@index([nextRunAt, status])
  @@map("fleet_missions")
}

/// Operação — execução individual de uma missão / chamada de chat / ação manual
model FleetOperation {
  id        String  @id @default(uuid())
  companyId String
  memberId  String
  missionId String?
  chatId    String?

  // Rastreamento de sub-operações (Onda 2.4 — spawn_subagent)
  parentOperationId String?
  depth             Int     @default(0) // 0 = root; max 2

  trigger FleetOperationTrigger
  status  FleetOperationStatus  @default(PENDING)

  instruction String @db.Text

  // Output
  output          String?   @db.Text
  toolsCalled     Json? // [{name, input, output, success, durationMs}]
  proposedActions Json? // se REQUIRE_APPROVAL: ações pendentes
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?

  // Métricas
  tokensInput  Int  @default(0)
  tokensOutput Int  @default(0)
  tokensCached Int  @default(0)
  durationMs   Int?

  error String? @db.Text

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  FleetMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mission FleetMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  chat    FleetChat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  parent  FleetOperation? @relation("SubOperations", fields: [parentOperationId], references: [id], onDelete: SetNull)
  children FleetOperation[] @relation("SubOperations")
  criticReview FleetCriticReview?

  @@index([companyId, status, createdAt])
  @@index([memberId, createdAt])
  @@index([missionId])
  @@index([parentOperationId])
  @@map("fleet_operations")
}

/// Chat interno (admin ↔ membro da Fleet) — diferente de Conversation (WhatsApp)
model FleetChat {
  id        String @id @default(uuid())
  companyId String
  memberId  String
  userId    String // dono (admin)

  title         String?
  totalMessages Int     @default(0)
  totalTokens   BigInt  @default(0)

  archivedAt DateTime?
  pinned     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member     FleetMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user       User             @relation("FleetChatOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages   FleetMessage[]
  operations FleetOperation[]

  @@index([companyId, userId, updatedAt])
  @@index([memberId])
  @@map("fleet_chats")
}

model FleetMessage {
  id     String           @id @default(uuid())
  chatId String
  role   FleetMessageRole

  content String @db.Text

  // Tool calls
  toolName    String?
  toolInput   Json?
  toolOutput  Json?
  toolSuccess Boolean?

  tokensInput  Int  @default(0)
  tokensOutput Int  @default(0)
  durationMs   Int?

  createdAt DateTime @default(now())

  chat FleetChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("fleet_messages")
}

/// Memória de longo prazo do FleetMember (Onda 2.2)
/// Fatos/preferências/regras extraídos das conversas, injetados no system prompt.
/// Permite o agente "lembrar" entre operations e chats diferentes.
model FleetMemoryEntry {
  id         String    @id @default(uuid())
  memberId   String
  scope      String    @default("member") // 'member' | 'global' (futuro: por empresa)
  kind       String // 'fact' | 'preference' | 'rule' | 'entity'
  key        String // ex: "admin.preferred_tone", "client.acme.contact_person"
  value      String    @db.Text
  confidence Float     @default(1.0)
  source     String? // chatId/operationId que gerou essa memória
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime?

  member FleetMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, scope, key])
  @@index([memberId, scope])
  @@index([expiresAt])
  @@map("fleet_memory_entries")
}
