generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── RBAC ──

enum DataScope {
  OWN // Apenas registros atribuídos ao próprio usuário
  OWN_ONLY // Apenas registros atribuídos ao próprio usuário (SEM pool de não-atribuídos)
  TEAM // Registros dos times do usuário
  COMPANY // Todos os registros da empresa
}

enum RoleType {
  SYSTEM // Criado pelo seed, não pode ser deletado
  CUSTOM // Criado pelo admin da empresa
}

enum InstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  BANNED
}

enum InstanceChannel {
  BAILEYS
  WHATSMEOW
  CLOUD_API
  COEXISTENCE
  EVO_GO
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
  SNOOZED
}

enum ConversationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model Company {
  id           String  @id @default(uuid())
  name         String
  document     String? @unique
  email        String  @unique
  phone        String?
  plan         String  @default("free") // Legacy - kept for backward compat
  planId       String? // FK to Plan table (new system)
  isActive     Boolean @default(true)
  webhookToken String? @unique // Token para webhook de entrada (extração de variáveis)

  // Daily Brain Digest — cron diário que vetoriza o histórico do dia anterior
  dailyBrainEnabled             Boolean @default(true)
  dailyBrainTimezone            String  @default("America/Sao_Paulo")
  dailyBrainHour                Int     @default(2)
  dailyBrainEmbeddingProviderId String?
  dailyBrainEmbeddingModel      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planRef                    Plan?                       @relation(fields: [planId], references: [id])
  users                      User[]
  instances                  Instance[]
  contacts                   Contact[]
  campaigns                  Campaign[]
  templates                  Template[]
  flows                      Flow[]
  webhookEvents              WebhookEvent[]
  automations                Automation[]
  conversations              Conversation[]
  teams                      Team[]
  roles                      Role[]
  windowSubscribers          WindowSubscriber[]
  labels                     Label[]
  customAttributeDefinitions CustomAttributeDefinition[]
  cannedResponses            CannedResponse[]
  customFilters              CustomFilter[]
  conversationAutomations    ConversationAutomation[]
  macros                     Macro[]
  aiProviders                AIProvider[]
  aiAgents                   AIAgent[]
  aiAgentSkills              AIAgentSkill[]
  aiAgentPromptVersions      AIAgentPromptVersion[]
  aiKnowledgeBases           AIKnowledgeBase[]
  aiKnowledgeSources         AIKnowledgeSource[]
  aiKnowledgeDocuments       AIKnowledgeDocument[]
  aiIngestionJobs            AIIngestionJob[]
  aiMCPServers               AIMCPServer[]
  aiTokenReports             AITokenReport[]
  aiProviderMetrics          AIProviderMetric[]
  aiMemories                 AIMemory[]
  aiAgentLearnings           AIAgentLearning[]
  aiArtifacts                AIArtifact[]
  fleetCriticReviews         FleetCriticReview[]
  aiBrainNodes               AIBrainNode[]
  aiBrainEdges               AIBrainEdge[]
  aiBrainFacts               AIBrainFact[]
  pipelines                  Pipeline[]
  pipelineStages             Stage[]
  pipelineCards              Card[]
  companyModules             CompanyModule[]
  scheduledMessages          ScheduledMessage[]
  sharedInstanceLinks        SharedInstanceLink[]

  // Relações CRM Comercial/Financeiro
  organizations         Organization[]
  customerAccounts      CustomerAccount[]
  customerActivityLogs  CustomerActivityLog[]
  leadProfiles          LeadProfile[]
  itemCategories        ItemCategory[]
  items                 CatalogItem[]
  itemBundles           ItemBundle[]
  proposals             Proposal[]
  invoices              Invoice[]
  payments              Payment[]
  creditNotes           CreditNote[]
  paymentGatewayConfigs PaymentGatewayConfig[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  contracts             Contract[]
  contractTemplates     ContractTemplate[]
  projects              Project[]
  projectTasks          Task[]
  documentCounters      DocumentCounter[]
  auditLogs             AuditLog[]
  workflows             Workflow[]

  // Tickets Internos e Goals
  tickets Ticket[]
  goals   Goal[]

  // Integrações de terceiros (FishAudio, Cal.com, etc) — modular/escalável
  integrations CompanyIntegration[]

  // Daily Brain Digest — auditoria/idempotência do job noturno
  dailyDigests AIDailyDigest[]

  // ── IMPA FLEET ──
  fleetDepartments FleetDepartment[]
  fleetMembers     FleetMember[]
  fleetMissions    FleetMission[]
  fleetOperations  FleetOperation[]
  fleetChats       FleetChat[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String   @unique
  password     String
  roleId       String // FK para Role (RBAC)
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  builderSettings Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rbacRole                 Role                      @relation(fields: [roleId], references: [id])
  assignedConversations    Conversation[]            @relation("ConversationAssignee")
  teamMemberships          TeamMember[]
  conversationParticipants ConversationParticipant[]
  customFilters            CustomFilter[]
  createdMacros            Macro[]                   @relation("MacroCreatedBy")
  updatedMacros            Macro[]                   @relation("MacroUpdatedBy")
  sentMessages             Message[]                 @relation("MessageSentByUser")
  assignedCards            Card[]                    @relation("CardAssignee")
  cardTasks                CardTask[]                @relation("TaskAssignee")
  cardNotes                CardNote[]                @relation("NoteAuthor")
  cardFiles                CardFile[]                @relation("FileUploader")
  scheduledMessagesCreated ScheduledMessage[]        @relation("scheduledMessagesCreated")
  sharedInstanceLinks      SharedInstanceLink[]
  taskAssignments          TaskAssignee[]            @relation("TaskAssigneeUser")
  instanceMemberships      InstanceMember[]
  csatAssignedResponses    CsatSurveyResponse[]      @relation("CsatAssignedAgent")
  workflowsCreated         Workflow[]                @relation("WorkflowCreator")

  // Tickets
  ticketsCreated  Ticket[]        @relation("TicketCreator")
  ticketsAssigned Ticket[]        @relation("TicketAssignee")
  ticketComments  TicketComment[]

  // Goals
  goalsOwned Goal[] @relation("GoalOwner")

  // IMPA FLEET
  fleetChats           FleetChat[]    @relation("FleetChatOwner")
  fleetMissionsCreated FleetMission[] @relation("FleetMissionCreator")

  @@map("users")
}

model Instance {
  id                String          @id @default(uuid())
  companyId         String
  name              String
  description       String?
  channel           InstanceChannel @default(BAILEYS)
  status            InstanceStatus  @default(DISCONNECTED)
  phoneNumber       String?
  profileName       String?
  profilePicture    String?
  apiToken          String          @unique @default(uuid())
  apiTokenExpiresAt DateTime? // null = never expires (legacy behavior)

  // Baileys specific
  sessionData Json?
  qrCode      String?

  // Cloud API specific
  wabaId        String?
  phoneNumberId String?
  accessToken   String?
  appId         String? // Meta App ID for upload/templates
  webhookSecret String?

  // Evo Go specific
  evoApiUrl     String? // URL base da Evo Go (ex: http://localhost:8080)
  evoInstanceId String? // UUID da instância na Evo Go
  evoApiKey     String? // Token (apikey) da instância na Evo Go

  // Webhooks
  webhookUrl    String?
  webhookEvents String[] @default([])

  // Metrics
  messagesSent     Int @default(0)
  messagesReceived Int @default(0)

  // History import (EVO_GO only)
  historySyncedAt  DateTime? // null = nunca importado; preenchido após importação do histórico

  // Settings
  rejectCalls      Boolean @default(false)
  ignoreGroups     Boolean @default(false)
  ignoreBroadcasts Boolean @default(false)
  ignoreStatus     Boolean @default(true)
  alwaysOnline     Boolean @default(false)
  readMessages     Boolean @default(true)

  // Business Hours
  workingHoursEnabled Boolean @default(false)
  outOfOfficeMessage  String? // Mensagem automática fora do horário
  timezone            String  @default("America/Sao_Paulo")

  // CSAT (Customer Satisfaction Survey)
  csatEnabled Boolean @default(false)
  csatMessage String? // Mensagem de pesquisa exibida ao contato

  // ── Transcrição manual de áudio (independente da IA) ──
  // sttConfig: { enabled: boolean, integrationId: string, model?: string, language?: string }
  sttConfig Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages           Message[]
  typebotIntegration TypebotIntegration?
  n8nIntegration     N8nIntegration?
  campaignInstances  CampaignInstance[]
  automations        Automation[]
  conversations      Conversation[]
  windowSubscribers  WindowSubscriber[]
  scheduledMessages  ScheduledMessage[]
  sharedLinks        SharedInstanceLink[]
  members            InstanceMember[]
  workingHours       WorkingHour[]
  csatResponses      CsatSurveyResponse[]

  @@map("instances")
}

model SharedInstanceLink {
  id             String    @id @default(uuid())
  instanceId     String
  companyId      String
  createdById    String
  token          String    @unique
  label          String? // nome descritivo opcional
  passwordHash   String? // bcrypt hash (se protegido por senha)
  theme          String    @default("dark") // "dark" ou "light"
  expiresAt      DateTime?
  maxUses        Int?
  currentUses    Int       @default(0)
  isActive       Boolean   @default(true)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instance  Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("shared_instance_links")
}

model Contact {
  id               String    @id @default(uuid())
  companyId        String
  name             String
  phoneNumber      String
  email            String?
  profilePicture   String? // Local cached avatar path (e.g. /uploads/avatars/xxx.jpg)
  pictureId        String? // WhatsApp pictureID — used to detect avatar changes
  isBusiness       Boolean?  @default(false) // Whether the contact uses WhatsApp Business
  tags             String[]  @default([])
  metadata         Json?
  isActive         Boolean   @default(true)
  lastInboundAt    DateTime? // Última mensagem recebida do contato (janela 24h)
  whatsappStatus   String? // Cached WhatsApp "about" text
  verifiedName     String? // Cached WhatsApp Business verified name
  whatsappSyncedAt DateTime? // Last time WhatsApp data was synced from Evo Go
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Novas relações comerciais
  organizationId String?
  source         String? // whatsapp, website, manual, import, api
  assignedTo     String? // userId responsável
  notes          String?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  conversations     Conversation[]
  messages          Message[]
  campaignContacts  CampaignContact[]
  cards             Card[]
  scheduledMessages ScheduledMessage[]

  // Relações comerciais
  leadProfile        LeadProfile?
  accountMemberships CustomerAccountContact[]
  proposals          Proposal[]
  invoices           Invoice[]
  contracts          Contract[]
  projects           Project[]
  tasks              Task[]                   @relation("TaskContact")
  gatewayCustomers   GatewayCustomer[]
  csatResponses      CsatSurveyResponse[]
  tickets            Ticket[]

  @@unique([companyId, phoneNumber])
  @@index([companyId, lastInboundAt])
  @@map("contacts")
}

// ══════════════════════════════════════════
// ═══ RBAC: Permissions, Roles ═══
// ══════════════════════════════════════════

model Permission {
  id          String  @id @default(uuid())
  module      String // "conversations", "contacts", "teams", etc.
  action      String // "read", "write", "delete", "manage"
  slug        String  @unique // "conversations:read", "contacts:write"
  description String? // "Ver conversas"

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String? // null = role global (SUPER_ADMIN)
  name        String // "Administrador", "Gerente", "Atendente"
  slug        String // "admin", "manager", "agent"
  description String?
  type        RoleType @default(CUSTOM)

  // ── Escopo padrão para este role ──
  defaultScope DataScope @default(OWN)

  // ── Configurações de conversa ──
  conversationScope     DataScope @default(OWN)
  canReplyConversations Boolean   @default(true)

  isDefault Boolean @default(false) // Role padrão para novos usuários

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]
  fleetMembers FleetMember[]    @relation("FleetMemberRole")

  @@unique([companyId, slug])
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  // Override de escopo por permissão (se null, usa defaultScope do Role)
  scopeOverride DataScope?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ══════════════════════════════════════════
// ═══ TEAMS ═══
// ══════════════════════════════════════════

model Team {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  description     String?
  allowAutoAssign Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  members       TeamMember[]
  cards         Card[]         @relation("CardTeam")
  tickets       Ticket[]

  @@unique([companyId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Conversation {
  id                   String                @id @default(uuid())
  companyId            String
  instanceId           String
  contactId            String
  remoteJid            String
  status               ConversationStatus    @default(OPEN)
  priority             ConversationPriority?
  assigneeId           String?
  teamId               String?
  customAttributes     Json?
  additionalAttributes Json?
  cachedLabelList      String?
  snoozedUntil         DateTime?
  lastActivityAt       DateTime              @default(now())
  firstReplyAt         DateTime?
  waitingSince         DateTime?
  // IA pausada manualmente para esta conversa (persistente, mesmo sem sessão criada).
  // Quando true, nenhum agente de IA responde mensagens deste contato/grupo nesta instância.
  aiPaused             Boolean               @default(false)
  aiPausedAt           DateTime?
  aiPausedReason       String?               @db.VarChar(120)
  aiPausedByUserId     String?
  pinnedAt             DateTime?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance           Instance                  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact            Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee           User?                     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team               Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages           Message[]
  participants       ConversationParticipant[]
  conversationLabels ConversationLabel[]
  events             ConversationEvent[]
  cards              Card[]
  taskConversations  Task[]
  csatResponse       CsatSurveyResponse?
  tickets            Ticket[]

  @@unique([instanceId, remoteJid])
  @@index([companyId, status, assigneeId])
  @@index([companyId, status, teamId])
  @@index([instanceId, lastActivityAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  instanceId     String
  contactId      String?
  conversationId String?
  remoteJid      String
  messageId      String           @unique
  direction      MessageDirection
  status         MessageStatus    @default(PENDING)
  type           String           @default("text")
  content        String
  mediaUrl       String?
  mediaType      String?
  templateId     String?
  metadata       Json?

  // Attribution: quem enviou a mensagem
  sentByUserId    String? // UUID do atendente humano que enviou
  sentByAIAgentId String? // UUID do agente de I.A. que enviou

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  failReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instance      Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sentByUser    User?         @relation("MessageSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)
  sentByAIAgent AIAgent?      @relation("MessageSentByAI", fields: [sentByAIAgentId], references: [id], onDelete: SetNull)

  @@index([instanceId, remoteJid])
  @@index([conversationId, createdAt])
  @@index([instanceId, direction, status])
  @@index([instanceId, createdAt])
  @@map("messages")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Template {
  id             String         @id @default(uuid())
  companyId      String
  name           String
  language       String         @default("pt_BR")
  category       String         @default("MARKETING")
  status         TemplateStatus @default(PENDING)
  headerType     String?
  headerContent  String?
  bodyText       String
  footerText     String?
  buttons        Json?
  metaId         String?        @unique
  rejectedReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("templates")
}

model Campaign {
  id             String         @id @default(uuid())
  companyId      String
  name           String
  description    String?
  status         CampaignStatus @default(DRAFT)
  messageType    String         @default("text")
  messageContent String
  mediaUrl       String?
  templateId     String?
  delay          Int            @default(3000)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalContacts  Int            @default(0)
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignInstances CampaignInstance[]
  campaignContacts  CampaignContact[]

  @@map("campaigns")
}

model CampaignInstance {
  id         String   @id @default(uuid())
  campaignId String
  instanceId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, instanceId])
  @@map("campaign_instances")
}

model CampaignContact {
  id         String        @id @default(uuid())
  campaignId String
  contactId  String
  status     MessageStatus @default(PENDING)
  sentAt     DateTime?
  error      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@map("campaign_contacts")
}

model TypebotIntegration {
  id           String   @id @default(uuid())
  instanceId   String   @unique
  typebotId    String
  typebotUrl   String
  triggerType  String   @default("all")
  triggerValue String?
  variables    Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("typebot_integrations")
}

model N8nIntegration {
  id         String   @id @default(uuid())
  instanceId String   @unique
  webhookUrl String
  events     String[] @default(["message.received"])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("n8n_integrations")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  // Ator AI/Sistema (quando a ação não foi feita por usuário humano)
  actorType String? // 'USER' | 'AI_MEMBER' | 'SYSTEM'
  actorId   String? // FleetMember.id quando actorType=AI_MEMBER
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, entity, action])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================
// FlowBuilder - Automação de Chatbot
// ============================================

enum FlowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FlowTriggerType {
  KEYWORD // Palavra-chave específica
  ALL // Todas as mensagens
  BUTTON_REPLY // Resposta de botão
  LIST_REPLY // Resposta de lista
  WEBHOOK // Trigger externo
}

model Flow {
  id          String     @id @default(uuid())
  companyId   String
  instanceId  String? // null = disponível para todas instâncias
  name        String
  description String?
  status      FlowStatus @default(DRAFT)

  // Trigger configuration
  triggerType  FlowTriggerType @default(KEYWORD)
  triggerValue String? // Palavra-chave ou padrão regex

  // Metadata
  version   Int   @default(1)
  variables Json? // Variáveis globais do fluxo
  settings  Json? // Configurações adicionais

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nodes    FlowNode[]
  edges    FlowEdge[]
  sessions FlowSession[]

  @@index([companyId, status])
  @@index([triggerType, triggerValue])
  @@map("flows")
}

enum FlowNodeType {
  START // Ponto de entrada
  MESSAGE // Mensagem de texto
  IMAGE // Enviar imagem
  AUDIO // Enviar áudio
  VIDEO // Enviar vídeo
  DOCUMENT // Enviar documento
  MENU // Menu numerado (texto)
  BUTTONS // Mensagem com botões
  CAROUSEL // Mensagem com carrossel
  LIST // Mensagem com lista/menu
  CONDITION // Condicional (if/else)
  DELAY // Aguardar X segundos
  SET_VARIABLE // Definir variável
  HTTP_REQUEST // Requisição HTTP externa
  TRANSFER // Transferir para atendente/fluxo
  GO_TO_FLOW // Ir para outro fluxo
  END // Finalizar fluxo
  // IA
  LLM // Chamar modelo de linguagem
  AI_AGENT // Delegar a agente IA
  KNOWLEDGE_RETRIEVAL // Busca RAG na base de conhecimento
  CODE // Executar código JavaScript
  TEMPLATE // Montar texto com variáveis
  LOOP // Repetir bloco de nós até condição ou maxIterations
  PARALLEL // Executar múltiplos sub-agentes em paralelo e combinar respostas
  QUESTION_CLASSIFIER // Classificar mensagem do usuário em categorias e rotear
  ITERATION // Iterar sobre lista (array): executa sub-fluxo para cada item, expondo {item, index}
  HUMAN_INPUT // Pausa o flow e aguarda input/aprovação humana via UI (formulário estruturado)
  APPROVAL // Pausa para aprovação binária (sim/não) — atalho do HUMAN_INPUT
  // CRM
  SEND_MESSAGE // Enviar mensagem WhatsApp via instância
  UPDATE_CONTACT // Atualizar dados do contato
  ASSIGN_CONVERSATION // Atribuir conversa a atendente/equipe
  ADD_TAG // Adicionar tag à conversa
  MOVE_CARD // Mover card no pipeline Kanban
  CREATE_TASK // Criar tarefa
  SEND_NOTIFICATION // Enviar notificação interna
}

model FlowNode {
  id     String       @id @default(uuid())
  flowId String
  type   FlowNodeType

  // Posição no canvas
  positionX Float @default(0)
  positionY Float @default(0)

  // Configuração específica do node (JSON)
  data Json

  // Metadados
  label String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow        Flow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  sourceEdges FlowEdge[] @relation("SourceNode")
  targetEdges FlowEdge[] @relation("TargetNode")

  @@index([flowId])
  @@map("flow_nodes")
}

model FlowEdge {
  id           String @id @default(uuid())
  flowId       String
  sourceNodeId String
  targetNodeId String

  // Handles para conexões específicas (ex: "yes", "no", "button_1")
  sourceHandle String?
  targetHandle String?

  // Label opcional
  label String?

  // Condição para seguir esta aresta (opcional)
  condition Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow       Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  sourceNode FlowNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode FlowNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@map("flow_edges")
}

// Sessão de um usuário em um fluxo
model FlowSession {
  id         String @id @default(uuid())
  flowId     String
  instanceId String
  remoteJid  String // Número do usuário

  currentNodeId String? // Nó atual
  variables     Json? // Variáveis da sessão
  context       Json? // Contexto adicional

  // Status
  isActive     Boolean @default(true)
  waitingInput Boolean @default(false)

  // Timestamps
  startedAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([instanceId, remoteJid, isActive])
  @@map("flow_sessions")
}

// ============================================
// Webhook de Entrada (simples - apenas recebe e extrai variáveis)
// ============================================

model WebhookEvent {
  id         String   @id @default(uuid())
  companyId  String
  rawPayload Json
  ipAddress  String
  userAgent  String?
  createdAt  DateTime @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variables WebhookVariable[]

  @@index([companyId, createdAt])
  @@map("webhook_events")
}

model WebhookVariable {
  id             String   @id @default(uuid())
  webhookEventId String
  key            String
  value          String
  valueType      String   @default("string")
  createdAt      DateTime @default(now())

  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)

  @@index([webhookEventId])
  @@map("webhook_variables")
}

// ============================================
// Automação de Disparo
// ============================================

enum AutomationStatus {
  ACTIVE
  INACTIVE
}

model Automation {
  id          String  @id @default(uuid())
  companyId   String
  instanceId  String
  name        String
  description String?

  // Endpoint próprio
  token String @unique @default(uuid())

  // Configuração de disparo
  status               AutomationStatus @default(INACTIVE)
  delayBetweenMessages Int              @default(3000) // ms entre mensagens

  // Para Cloud API - template homologado
  metaTemplateName     String? // Nome do template na Meta
  metaTemplateLanguage String? @default("pt_BR")

  // Fallback: usar texto livre se janela 24h aberta, senão template
  useWindowFallback    Boolean @default(false) // Ativar lógica de janela 24h
  fallbackTemplateName String? // Template para usar quando janela fechada

  // Codigo para identificar template (ex: $Template1, $Template2, $Template3)
  // Usado para roteamento automatico quando o payload contem esse codigo
  templateCode String? // Ex: "$Template1", "$Template2", "$Template3"

  // Tipo de template para roteamento automático quando não há código
  // FATURA_DIA = quando tem arquivo_url (boleto/fatura)
  // DISPARO_LIVRE = quando não tem arquivo_url (mensagem livre)
  // null = automação normal por token
  templateType String? // "FATURA_DIA" | "DISPARO_LIVRE"

  // Corpo da mensagem (JSON) - usado para Baileys ou preview
  messageBody Json?

  // Mapeamento de variáveis: {"to": "telefone", "name": "nome"}
  variableMapping Json?

  // Campo que contém o telefone de destino
  phoneField String @default("telefone")

  // Estatísticas
  totalSent       Int       @default(0)
  totalFailed     Int       @default(0)
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance Instance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  logs     AutomationLog[]

  @@index([companyId])
  @@index([token])
  @@map("automations")
}

enum AutomationLogStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

// Assinantes de janela 24h - números que precisam manter janela aberta
model WindowSubscriber {
  id           String    @id @default(uuid())
  companyId    String
  instanceId   String // Instância Cloud API para enviar notificações
  phoneNumber  String // Número que precisa da janela aberta
  name         String? // Nome para identificação
  notifyTime   String    @default("17:30") // Horário para enviar notificação (HH:mm)
  isActive     Boolean   @default(true)
  lastNotified DateTime? // Última vez que foi notificado
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([companyId, phoneNumber])
  @@index([isActive, notifyTime])
  @@map("window_subscribers")
}

model AutomationLog {
  id             String              @id @default(uuid())
  automationId   String
  phoneNumber    String
  messageContent String?
  payload        Json? // Payload recebido
  status         AutomationLogStatus @default(QUEUED)
  apiMessageId   String?
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@map("automation_logs")
}

// ============================================
// Labels (Etiquetas)
// ============================================

model Label {
  id            String   @id @default(uuid())
  companyId     String
  title         String
  description   String?
  color         String   @default("#1f93ff")
  showOnSidebar Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationLabels ConversationLabel[]
  cardTags           CardTag[]

  @@unique([companyId, title])
  @@map("labels")
}

model ConversationLabel {
  id             String   @id @default(uuid())
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([conversationId, labelId])
  @@map("conversation_labels")
}

// ============================================
// Custom Attributes (Atributos Personalizados)
// ============================================

enum CustomAttributeModel {
  CONVERSATION
  CONTACT
}

enum CustomAttributeType {
  TEXT
  NUMBER
  LINK
  DATE
  LIST
  CHECKBOX
}

model CustomAttributeDefinition {
