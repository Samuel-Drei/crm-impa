model CannedResponse {
  id        String   @id @default(uuid())
  companyId String
  shortCode String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, shortCode])
  @@map("canned_responses")
}

// ============================================
// Custom Filters (Filtros Salvos)
// ============================================

model CustomFilter {
  id         String   @id @default(uuid())
  companyId  String
  userId     String
  name       String
  filterType String   @default("conversation")
  query      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_filters")
}

// ============================================
// Conversation Automations (Automações de Conversa - Event-Driven)
// ============================================

model ConversationAutomation {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  eventName   String
  conditions  Json     @default("[]")
  actions     Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, eventName, isActive])
