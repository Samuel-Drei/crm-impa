// ============================================
// Macros (Ações Manuais em Lote)
// ============================================

enum MacroVisibility {
  PERSONAL
  GLOBAL
}

model Macro {
  id          String          @id @default(uuid())
  companyId   String
  name        String
  visibility  MacroVisibility @default(PERSONAL)
  actions     Json            @default("[]")
  createdById String?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("MacroCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("MacroUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("macros")
}

// ============================================
// AI - Sistema de Inteligência Artificial
// ============================================

enum AIProviderType {
  // ── API Key Providers ──
  OPENAI
  GEMINI
  CLAUDE
  DEEPSEEK
  GROQ
  OPENROUTER
  PERPLEXITY
  MISTRAL
  COHERE
  XAI
  TOGETHER
  FIREWORKS
  CEREBRAS
  GITHUB_MODELS
  // ── OAuth Providers ──
  GITHUB_COPILOT
  ANTIGRAVITY
  // ── OpenAI-Compatible (custom endpoint) ──
  OPENAI_COMPATIBLE
}

enum AIAgentType {
  LLM // Agente simples com LLM
  SEQUENTIAL // Executa sub-agentes em sequência
  WORKFLOW // Fluxo com nodes/edges
}

enum RoutingStrategy {
  BEST_PERFORMANCE // Seleciona melhor por latência, erro, custo
  ROUND_ROBIN // Distribui aleatoriamente entre providers (evita rate limit)
  COST_OPTIMIZED // Prioriza menor custo
}

enum AIAgentStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum AIAgentPromptField {
  SYSTEM_PROMPT
  FOLLOW_UP_PROMPT
}

enum AIPromptPatchOperation {
  REPLACE
  INSERT_BEFORE
  INSERT_AFTER
  APPEND
  REMOVE
}

enum AISessionStatus {
  OPENED
  PAUSED
  CLOSED
}

enum AITriggerType {
  KEYWORD // Ativa por palavra-chave
  ALL // Todas as mensagens
  ADVANCED // Regex ou condição avançada
  NONE // Desabilitado
}

enum AITriggerOperator {
  CONTAINS // Contém
  EQUALS // Igual
  STARTS_WITH // Começa com
  ENDS_WITH // Termina com
  REGEX // Expressão regular
}

enum AIScheduleMode {
  ALWAYS // 24/7 — responde sempre
  BUSINESS_HOURS // Apenas dentro do horário comercial da instância (working_hours)
  OUT_OF_BUSINESS_HOURS // Apenas FORA do horário comercial da instância
  CUSTOM // Slots customizados definidos em scheduleSlots
}

model AIProvider {
  id                String         @id @default(uuid())
  companyId         String
  name              String
  type              AIProviderType
  authType          String         @default("apikey") // "apikey" | "oauth" | "import_token"
  apiKey            String // Chave de API ou access token (encriptado)
  model             String // Modelo padrão (legacy/fallback)
  enabledModels     String[]       @default([]) // Modelos habilitados para esta chave
  baseUrl           String? // URL customizada (para proxies/endpoints alternativos)
  maxTokens         Int            @default(4096)
  temperature       Float          @default(0.7)
  topP              Float? // 0..1 — nucleus sampling (opcional)
  frequencyPenalty  Float? // -2..2 — penaliza repetição de tokens (opcional)
  presencePenalty   Float? // -2..2 — penaliza repetição de tópicos (opcional)
  isActive          Boolean        @default(true)
  isDefault         Boolean        @default(false)
  // ── OAuth fields ──
  refreshToken      String? // OAuth refresh token (encriptado)
  tokenExpiresAt    DateTime? // Quando o access token expira
  oauthData         Json? // Dados extras (copilotToken, projectId, etc.)
  // ── Heartbeat / Health ──
  healthStatus      String         @default("UNKNOWN") // HEALTHY | DEGRADED | DOWN | UNKNOWN
  lastHealthCheckAt DateTime?
  lastHealthError   String?
  healthLatencyMs   Int?
  consecutiveErrors Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agents            AIAgent[]
  knowledgeBases    AIKnowledgeBase[]
  scheduledMessages ScheduledMessage[]
  metrics           AIProviderMetric[]
  fleetMembers      FleetMember[]      @relation("FleetMemberProvider")

  @@unique([companyId, name])
  @@map("ai_providers")
}

model AIAgent {
  id          String        @id @default(uuid())
  companyId   String
  providerId  String
  model       String? // Modelo específico do agente (se null, usa provider.model)
  name        String
  description String?
  type        AIAgentType   @default(LLM)
  status      AIAgentStatus @default(DRAFT)

  // Prompt e personalidade
  systemPrompt   String // Prompt do sistema/personalidade
  welcomeMessage String? // Mensagem de boas-vindas

  // Configurações do bot WhatsApp
  triggerType      AITriggerType     @default(ALL)
  triggerOperator  AITriggerOperator @default(CONTAINS)
  triggerValue     String? // Palavra-chave ou regex
  keywordFinish    String?           @default("#sair") // Palavra para encerrar sessão
  unknownMessage   String? // Mensagem quando não entende
  delayMessage     Int               @default(1000) // Delay antes de responder (ms)
  splitMessages    Boolean           @default(false) // Dividir mensagens longas em parágrafos
  timePerChar      Int               @default(0) // Ms por caractere no split (0=desabilitado)
  maxMessageLength Int               @default(4000) // Tamanho máximo por mensagem

  // Sessão
  sessionTimeout  Int     @default(30) // Minutos para expirar sessão
  keepOpen        Boolean @default(false) // Manter sessão aberta sempre
  listeningFromMe Boolean @default(false) // Escutar mensagens enviadas por mim
  stopBotFromMe   Boolean @default(true) // Parar bot quando eu envio mensagem
  debounceTime    Int     @default(3) // Segundos para agrupar mensagens

  // Follow-up (reengajamento automático)
  followUpEnabled          Boolean @default(false) // Ativar follow-up
  followUpSteps            Json?   // Array de steps: [{delayMinutes, type, message}]
  followUpPrompt           String? // Prompt padrão para IA gerar follow-up
  followUpCloseOnMax       Boolean @default(true)  // @deprecated — use followUpEndAction
  followUpCloseMessage     String? // Mensagem ao fechar/pausar por max follow-ups
  // Ação após último step (substitui followUpCloseOnMax):
  //   CLOSE — encerra sessão (nova sessão possível se gatilho bater)
  //   PAUSE — pausa sessão  (IA não responde até retomar)
  //   NONE  — mantém sessão aberta (IA fica disponível sem follow-ups)
  followUpEndAction        String  @default("CLOSE")  // "CLOSE" | "PAUSE" | "NONE"
  followUpEndDelayMinutes  Int     @default(0)         // minutos de espera após último step antes de aplicar a ação
  // Auto-retomar sessão pausada
  pauseAutoResumeEnabled   Boolean @default(false)
  pauseAutoResumeMinutes   Int     @default(60)        // minutos para retomar
  pauseAutoResumeTrigger   String  @default("PAUSED_AT") // "PAUSED_AT" | "LAST_CONTACT_MSG" | "LAST_ATTENDANT_MSG"
  // Campos legados (mantidos para compatibilidade)
  followUpDelay            Int     @default(5)
  followUpMaxAttempts      Int     @default(3)
  followUpInterval         Int     @default(10)
  followUpMode             String  @default("AI_GENERATED")
  followUpMessages         Json?

  // Filtros
  ignoreGroups Boolean  @default(true) // Ignorar mensagens de grupos (@g.us)
  ignoreJids   String[] @default([]) // JIDs específicos para ignorar
  allowJids    String[] @default([]) // Se preenchido, SOMENTE esses JIDs são atendidos
  isDefault    Boolean  @default(false) // Bot padrão da instância

  // Agendamento — quando o agente pode responder
  scheduleMode       AIScheduleMode @default(ALWAYS) // ALWAYS | BUSINESS_HOURS | OUT_OF_BUSINESS_HOURS | CUSTOM
  scheduleTimezone   String?        @default("America/Sao_Paulo") // Timezone para os slots CUSTOM
  scheduleSlots      Json?          @default("[]") // Slots CUSTOM: [{dayOfWeek:0-6, openHour, openMinutes, closeHour, closeMinutes}]
  scheduleOffMessage String? // Mensagem opcional enviada quando estiver fora do horário

  // Contexto CRM
  useCrmContext          Boolean @default(true) // Usar dados do CRM como contexto
  useContactInfo         Boolean @default(true) // Incluir info do contato no contexto
  useConversationHistory Boolean @default(true) // Incluir histórico da conversa
  contextMessagesLimit   Int     @default(10) // Mensagens pré-sessão para carregar como contexto
  sessionMessagesLimit   Int     @default(50) // Máximo de mensagens da sessão para enviar ao LLM

  // ── Sandbox CRM: controle granular do que a IA pode ver/alterar ──
  // Se null, usa padrão: tudo habilitado (compatível com agentes existentes)
  crmToolsConfig Json? // CRM sandbox config: {
  //   sandboxMode: 'CURRENT_ONLY' | 'COMPANY',
  //   read: { contact_name, contact_email, contact_phone, contact_tags, custom_fields,
  //           conversation_status, conversation_assignee, conversation_team, conversation_labels,
  //           conversation_priority, conversation_history, teams, canned_responses },
  //   write: { contact_name, contact_email, contact_tags, custom_fields,
  //            conversation_assign, conversation_notes, contact_create },
  //   enabledTools: string[]  // Lista de CRM tools habilitadas
  // }

  // Instâncias vinculadas (null = todas)
  instanceIds String[] @default([])

  // MCP Servers vinculados ao agente
  mcpServerIds String[] @default([])

  // HTTP Tools configuradas visualmente (formato rico)
  httpTools Json? // Array de HTTP tools configuradas

  // Smart Routing — roteamento inteligente entre providers
  useSmartRouting    Boolean         @default(false) // Se true, seleciona automaticamente o melhor provider por métricas
  routingStrategy    RoutingStrategy @default(BEST_PERFORMANCE) // Estratégia de seleção
  routingProviderIds String[]        @default([]) // IDs dos providers participantes (vazio = todos)

  // ── Voz / TTS ──
  // voiceConfig: {
  //   enabled: boolean,
  //   integrationId: string,        // CompanyIntegration.id (FISHAUDIO etc)
  //   modelId: string,              // ID da voz no provider (FishAudio reference_id)
  //   mode: 'AI_DECIDES' | 'ALWAYS_AUDIO' | 'ALWAYS_TEXT' | 'AUTO_WHEN_RECEIVED_AUDIO',
  //   conditions?: { keywords?: string[], maxLength?: number, ... }
  // }
  voiceConfig Json?

  // ── STT / Transcrição configurada por agente ──
  // sttConfig: { integrationId: string, model?: string, language?: string }
  sttConfig Json?

  // ── Agenda (Cal.com etc) — múltiplas agendas suportadas ──
  // calendarConfig: {
  //   integrationId: string,
  //   eventTypes: [{ id, slug, title, label?, scope? }],   // múltiplas agendas/event types
  //   defaultEventTypeId?: string,
  //   tools: { list_event_types, get_available_slots, create_booking, list_bookings, cancel_booking, reschedule_booking }
  // }
  calendarConfig Json?

  // ── State Tracker — variáveis de estado da conversa rastreadas automaticamente ──
  // stateSchema: {
  //   enabled: boolean,
  //   extractorModel?: string,   // modelo barato pra extração (ex: gpt-4o-mini). Se null, usa o do agente
  //   extractorProviderId?: string,
  //   variables: [
  //     { name: 'produto_escolhido', type: 'enum', values: ['Alimentacao','Suplementos','Petiscos','Todos'], description: '...' },
  //     { name: 'nome_pet', type: 'string', description: '...' },
  //     { name: 'peso_atual', type: 'number', description: 'em kg' },
  //     ...
  //   ],
  //   // Estratégia: extrair toda mensagem do user, ou só quando schema mudaria
  //   onlyOnUserMessage: boolean   // default true
  // }
  stateSchema Json?

  // ── Sub-agentes (Padrão A: pré-criados, expostos como tools call_subagent_<slug>) ──
  // Quando outro agente liga este como filho, ele pode chamar via tool. O "isSubAgent" é
  // só uma marcação opcional pra UI — qualquer agente pode ser usado como sub-agente.
  isSubAgent          Boolean  @default(false)
  subAgentDescription String? // Descrição que vira `description` da tool no agente pai
  subAgentIds         String[] @default([]) // IDs de outros AIAgent que ESTE agente pode chamar como sub-agentes

  // Configurações avançadas
  settings Json? // Configs adicionais (tools, sub-agentes, etc)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider       AIProvider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sessions       AISession[]
  messages       AIMessage[]
  knowledgeBases AIAgentKnowledge[]
  promptVersions AIAgentPromptVersion[]
  skills         AIAgentSkill[]
  learnings      AIAgentLearning[]
  sentMessages   Message[]              @relation("MessageSentByAI")

  @@index([companyId, status])
  @@map("ai_agents")
}

// ============================================
// Integrações de terceiros (escalável/modular)
// ============================================

enum CompanyIntegrationType {
  // ── Voz / TTS / STT ──
  FISHAUDIO
  ELEVENLABS
  OPENAI
  // ── Calendário / Agendamento ──
  CALCOM
  GOOGLE_CALENDAR
  // ── Outras ──
  CUSTOM
}

enum CompanyIntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

/// Integrações de terceiros conectadas pela empresa.
/// `credentials` é SEMPRE armazenada criptografada (AES-256-GCM via crypto util).
/// Várias instâncias da mesma integração são permitidas (ex: várias contas Cal.com).
model CompanyIntegration {
  id          String                   @id @default(uuid())
  companyId   String
  type        CompanyIntegrationType
  name        String // Nome amigável definido pelo usuário (ex: "Cal.com Clínica Centro")
  description String?
  status      CompanyIntegrationStatus @default(ACTIVE)

  // Credenciais (sempre criptografadas no backend antes de persistir).
  // Estrutura é específica por type, ex:
  //   FISHAUDIO: { apiKey }
  //   CALCOM:    { apiKey, baseUrl?, accountSlug? }
  //   GOOGLE_CALENDAR: { accessToken, refreshToken, expiresAt }
  credentials String // string Base64 do payload criptografado

  // Config pública (NÃO sensível) — defaults, opções, cache
  config Json? // ex CALCOM: { eventTypes: [{id,slug,title,scope}], lastSync }

  // Capacidades habilitadas pelo usuário (toggle granular)
  // ex: { tts: true, stt: true, voiceTraining: false }
  capabilities Json?

  // Saúde / monitoramento
  lastTestedAt   DateTime?
  lastError      String?
  lastUsageAt    DateTime?
  totalRequests  Int       @default(0)
  failedRequests Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, status])
  @@map("company_integrations")
}

model AIAgentPromptVersion {
  id                    String                 @id @default(uuid())
  companyId             String
  agentId               String
  field                 AIAgentPromptField
  instruction           String
  operation             AIPromptPatchOperation
  targetStrategy        String
  targetMeta            Json?
  oldText               String
  newText               String
  resultText            String
  diffJson              Json?
  confidence            Float?
  needsConfirmation     Boolean                @default(false)
  warnings              Json?
  restoredFromVersionId String?
  createdById           String?
  createdAt             DateTime               @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([companyId, agentId, field, createdAt])
  @@index([agentId, createdAt])
  @@map("ai_agent_prompt_versions")
}

model AISession {
  id         String          @id @default(uuid())
  agentId    String
  instanceId String
  remoteJid  String // Número do WhatsApp
  status     AISessionStatus @default(OPENED)

  // Contexto da sessão
  context   Json? // Dados de contexto acumulados
  variables Json? // Variáveis da sessão

  // Métricas
  messageCount     Int   @default(0)
  tokensUsed       Int   @default(0)
  promptTokens     Int   @default(0) // Soma tokens input da sessão
  completionTokens Int   @default(0) // Soma tokens output da sessão
  costUsd          Float @default(0) // Custo total USD da sessão

  // Follow-up tracking
  lastMessageRole   String?   // 'user' ou 'assistant' - quem mandou a última msg
  followUpCount     Int       @default(0) // Qual step estamos (index do array)
  lastFollowUpAt    DateTime? // Quando foi enviado o último follow-up
  followUpStartedAt DateTime? // Referência: quando a IA enviou a msg original (ponto zero dos delays)

  startedAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  closedAt     DateTime?
  pausedAt     DateTime? // quando a sessão foi pausada (para auto-resume)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent    AIAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@unique([agentId, instanceId, remoteJid])
  @@index([instanceId, remoteJid, status])
  @@map("ai_sessions")
}

model AIMessage {
  id               String   @id @default(uuid())
  sessionId        String
  agentId          String
  role             String // "user", "assistant", "system"
  content          String
  tokensUsed       Int? // Total tokens (prompt + completion)
  promptTokens     Int? // Tokens de input (contabilizado)
  completionTokens Int? // Tokens de output (contabilizado)
  costUsd          Float? // Custo em USD desta mensagem
  modelUsed        String? // Modelo exato usado (ex: gpt-4o-mini)
  latencyMs        Int? // Tempo de resposta em ms
  metadata         Json? // Dados extras
  createdAt        DateTime @default(now())

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   AIAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([agentId, createdAt])
  @@index([modelUsed, createdAt])
  @@map("ai_messages")
}

// ============================================
// Knowledge Base — Container lógico (como Dataset do Dify)
// ============================================

model AIKnowledgeBase {
  id                  String    @id @default(uuid())
  companyId           String
  name                String
  description         String?
  // Configuração de embedding — vincula ao provider da empresa (como no Dify)
  embeddingProviderId String? // FK para AIProvider — usa a apiKey dele
  embeddingProvider   String    @default("openai") // tipo derivado do provider ("openai", "gemini", etc.)
  embeddingModel      String    @default("text-embedding-3-small")
  embeddingApiKey     String? // LEGACY — mantido para compat, preferir embeddingProviderId
  embeddingBaseUrl    String? // URL customizada (Ollama, Azure, proxy)
  embeddingDimension  Int       @default(1536)
  chunkSize           Int       @default(500)
  chunkOverlap        Int       @default(50)
  // Configuração de retrieval
  retrievalMode       String    @default("hybrid") // "semantic", "keyword", "hybrid"
  topK                Int       @default(5)
  scoreThreshold      Float     @default(0.5)
  // Legacy fields (mantidos para compat)
  type                String    @default("text")
  content             String?
  fileUrl             String?
  sourceUrl           String?
  // Status
  metadata            Json?
  isActive            Boolean   @default(true)
  totalDocuments      Int       @default(0)
  totalChunks         Int       @default(0)
  totalTokens         Int       @default(0)
  indexingStatus      String    @default("ready") // "ready", "indexing", "error"
  lastIndexedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  embeddingProviderRef AIProvider?           @relation(fields: [embeddingProviderId], references: [id], onDelete: SetNull)
  agents               AIAgentKnowledge[]
  sources              AIKnowledgeSource[]
  documents            AIKnowledgeDocument[]

  @@index([companyId])
  @@map("ai_knowledge_bases")
}

model AIAgentKnowledge {
  id              String   @id @default(uuid())
  agentId         String
  knowledgeBaseId String
  createdAt       DateTime @default(now())

  agent         AIAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase AIKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeBaseId])
  @@map("ai_agent_knowledge")
}

// ============================================
// Knowledge Source — Origem da informação (text, file, url, website, youtube)
// ============================================

enum KnowledgeSourceType {
  TEXT
  FILE
  URL
  WEBSITE
  YOUTUBE
  QA
}

enum SourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  QUEUED
}

model AIKnowledgeSource {
  id              String              @id @default(uuid())
  companyId       String
  knowledgeBaseId String
  type            KnowledgeSourceType
  name            String
  // Dados da fonte
  textContent     String? // para tipo TEXT
  fileUrl         String? // para tipo FILE
  fileName        String?
  fileMimeType    String?
  fileSize        Int?
  sourceUrl       String? // para tipo URL, WEBSITE, YOUTUBE
  // Para tipo QA: array de pares [{ id, question, answer, active, order }]
  qaItems         Json?
  // Config website crawl
  crawlConfig     Json? // {maxPages, maxDepth, includePatterns, excludePatterns, respectRobots}
  // Crawl versioning (inspirado Dify/Firecrawl)
  crawlVersion    Int                 @default(1) // Incrementa a cada recrawl
  lastCrawlHash   String? // Hash do sitemap/fingerprint (detectar mudança)
  canonicalUrl    String? // URL canônica resolvida
  pagesDiscovered Int                 @default(0) // Total de páginas encontradas pelo crawler
  // Status
  status          SourceStatus        @default(PENDING)
  errorMessage    String?
  // Métricas
  totalDocuments  Int                 @default(0)
  totalChunks     Int                 @default(0)
  totalTokens     Int                 @default(0)
  processedAt     DateTime?
  lastCrawledAt   DateTime?
  // Metadata
  metadata        Json?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledgeBase AIKnowledgeBase       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documents     AIKnowledgeDocument[]
  jobs          AIIngestionJob[]

  @@index([companyId])
  @@index([knowledgeBaseId])
  @@index([status])
  @@map("ai_knowledge_sources")
}

// ============================================
// Knowledge Document — Item processado de uma source (1 source pode gerar N documents)
// ============================================

model AIKnowledgeDocument {
  id                   String       @id @default(uuid())
  companyId            String
  knowledgeBaseId      String
  sourceId             String
  // Dados do documento
  title                String?
  sourceUrl            String? // URL canônica do doc (deduplicação)
  canonicalUrl         String? // URL canônica real (via <link rel="canonical">)
  contentHash          String? // Hash do conteúdo (detectar mudanças)
  rawContent           String? // Texto bruto extraído
  cleanContent         String? // Texto limpo (sem HTML, markdown)
  wordCount            Int          @default(0)
  tokenCount           Int          @default(0)
  // Versionamento (inspirado Dify document model)
  crawlVersion         Int          @default(1) // Versão do crawl que gerou este doc
  language             String? // Idioma detectado do conteúdo
  publishedAt          DateTime? // Data de publicação (se extraível)
  // Parsing info (Docling / local)
  pageCount            Int? // Número de páginas (PDF, DOCX, PPTX)
  parsingMethod        String? // "docling", "local_pdf", "local_docx", etc
  fileSize             Int? // Tamanho do arquivo em bytes
  // Status
  status               SourceStatus @default(PENDING)
  errorMessage         String?
  enabled              Boolean      @default(true) // Ativar/desativar sem deletar (padrão Dify)
  // Referência Qdrant
  qdrantCollectionName String?
  totalChunks          Int          @default(0)
  indexedAt            DateTime?
  // Metadata (lang, author, publishDate, etc)
  metadata             Json?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledgeBase AIKnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  source        AIKnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks        AIKnowledgeChunk[]

  @@unique([knowledgeBaseId, sourceUrl])
  @@index([companyId])
  @@index([knowledgeBaseId])
  @@index([sourceId])
  @@index([contentHash])
  @@map("ai_knowledge_documents")
}

// ============================================
// Knowledge Chunk — Pedaço pesquisável do documento (indexado no Qdrant)
// ============================================

model AIKnowledgeChunk {
  id            String   @id @default(uuid())
  documentId    String
  // Dados do chunk
  content       String // Texto do chunk
  chunkIndex    Int // Posição no documento (0, 1, 2...)
  tokenCount    Int      @default(0)
  wordCount     Int      @default(0) // Contagem de palavras
  // Rastreabilidade (inspirado Dify segment model)
  hitCount      Int      @default(0) // Quantas vezes retornado em busca
  enabled       Boolean  @default(true) // Ativar/desativar sem deletar
  // Estrutura documental (heading-aware chunking)
  sectionTitle  String? // Título da seção (heading mais próximo)
  pageNumber    Int? // Número da página de origem
  elementType   String? // "paragraph", "table", "list_item", "code", etc
  // Referência Qdrant
  qdrantPointId String? // ID do ponto no Qdrant
  isIndexed     Boolean  @default(false)
  // Metadata
  metadata      Json? // {page, section, heading, ...}
  createdAt     DateTime @default(now())

  document AIKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([qdrantPointId])
  @@map("ai_knowledge_chunks")
}

// ============================================
// Ingestion Job — Job assíncrono de ingestão (como Firecrawl/Dify)
// ============================================

enum IngestionJobType {
  INDEX_SOURCE
  CRAWL_WEBSITE
  REINDEX_SOURCE
  DELETE_SOURCE
}

model AIIngestionJob {
  id                 String           @id @default(uuid())
  companyId          String
  sourceId           String
  type               IngestionJobType
  // Status
  status             SourceStatus     @default(QUEUED)
  progress           Int              @default(0) // 0-100
  currentStep        String? // "crawling", "extracting", "chunking", "embedding", "indexing"
  errorMessage       String?
  // Métricas
  documentsFound     Int              @default(0)
  documentsProcessed Int              @default(0)
  chunksCreated      Int              @default(0)
  tokensUsed         Int              @default(0)
  // Timing
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  AIKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sourceId])
  @@index([status])
  @@map("ai_ingestion_jobs")
}

// ============================================
// AI Token Report — Agregação diária de uso/custo por agente/instância
// ============================================

model AITokenReport {
  id         String   @id @default(uuid())
  companyId  String
  agentId    String?
  instanceId String?
  date       DateTime // Data do dia (truncado a 00:00)

  // Contagens
  messagesCount Int @default(0) // Mensagens assistente naquele dia
  sessionsCount Int @default(0) // Sessões iniciadas naquele dia

  // Tokens
  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  // Custo
  costUsd    Float  @default(0)
  costBrl    Float  @default(0) // Custo em BRL (cotação do dia)
  usdBrlRate Float? // Taxa de câmbio usada

  // Breakdown por modelo
  modelBreakdown Json? // [{model, tokens, cost}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, agentId, instanceId, date])
  @@index([companyId, date])
  @@index([agentId, date])
  @@index([instanceId, date])
  @@map("ai_token_reports")
}

// ============================================
// AI Tool Execution Logs — Registro completo de cada execução de tool
// ============================================

model AIToolLog {
  id        String  @id @default(uuid())
  sessionId String?
  agentId   String
  companyId String

  // Identificação da tool
  toolName String
  toolType String // "http_request", "crm", "mcp"
  moduleId String? // ID do módulo que contém a tool

  // Request
  requestMethod  String? // GET, POST, etc.
  requestUrl     String?
  requestHeaders Json?
  requestBody    Json?
  requestParams  Json?

  // Response
  responseStatus  Int?
  responseHeaders Json?
  responseBody    String? @db.Text
  responseTime    Int? // ms

  // Resultado
  status       String  @default("pending") // "pending", "success", "error", "timeout", "retry"
  errorMessage String?
  errorStack   String? @db.Text
  retryCount   Int     @default(0)
  retryOf      String? // ID do log original que gerou retry

  // Resultado processado (o que foi devolvido ao LLM)
  resultForLLM String? @db.Text

  // Contexto
  triggeredBy String? // "function_calling", "workflow", "manual"
  metadata    Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([sessionId, createdAt])
  @@index([agentId, createdAt])
  @@index([companyId, createdAt])
  @@index([toolType, status])
  @@map("ai_tool_logs")
}

// ============================================
// AI Agent Template — Templates pré-configurados de agentes
// ============================================

model AIAgentTemplate {
  id          String  @id @default(uuid())
  slug        String  @unique // Identificador único (ex: "vendas-b2b")
  name        String // Nome de exibição
  description String // Descrição detalhada
  category    String // Vendas, Suporte, Atendimento, Marketing, RH, Financeiro
  icon        String? // Emoji ou ícone
  color       String? // Cor do card

  // Configuração do agente (copiada ao instanciar)
  systemPrompt   String          @db.Text // Prompt do sistema
  welcomeMessage String? // Mensagem de boas-vindas
  model          String? // Modelo sugerido (ex: "gpt-4o-mini")
  providerType   AIProviderType? // Provider sugerido

  // Configurações sugeridas
  triggerType      AITriggerType @default(ALL)
  keywordFinish    String?       @default("#sair")
  sessionTimeout   Int           @default(30)
  splitMessages    Boolean       @default(false)
  maxMessageLength Int           @default(4000)
  delayMessage     Int           @default(1000)

  // Follow-up pré-configurado
  followUpEnabled Boolean @default(false)
  followUpSteps   Json? // Steps padrão do template
  followUpPrompt  String?

  // Tools sugeridas
  suggestedTools    Json? // { crmTools: [...], httpTools: [...] }
  suggestedSettings Json? // Settings extras

  // Contexto
  useCrmContext          Boolean @default(true)
  useContactInfo         Boolean @default(true)
  useConversationHistory Boolean @default(true)
  contextMessagesLimit   Int     @default(10)
  sessionMessagesLimit   Int     @default(50)

  // Metadata
  tags       String[] @default([])
  difficulty String   @default("beginner") // beginner, intermediate, advanced
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  usageCount Int      @default(0) // Quantas vezes foi usado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive, sortOrder])
  @@map("ai_agent_templates")
}

// ============================================
// AI Agent Skill — Procedural memory vetorizada (playbooks reutilizáveis)
//
// Cada skill é um "playbook" com:
//   - conditions[]: frases que descrevem QUANDO a skill deve ativar
//   - instructions: o playbook em si (só é carregado no prompt quando a skill é ativada)
//
// O backend vetoriza (name + description + conditions) no Qdrant. Antes de cada
// chamada ao LLM, busca top-K skills relevantes para a mensagem do usuário e
// injeta apenas essas no system prompt — economizando tokens massivamente vs
// carregar todos os playbooks sempre.
//
// agentId == null ⇒ skill compartilhada por TODOS os agentes da empresa.
// agentId != null ⇒ skill específica daquele agente.
//
// priority >= 100 ⇒ sempre carrega (always-on, ex: regras de compliance).
// ============================================
model AIAgentSkill {
  id          String  @id @default(uuid())
  companyId   String
  agentId     String? // null = skill global da empresa (compartilhada por todos os agentes)
  name        String
  slug        String // unique por empresa
  description String?

  // Procedural memory
  conditions   String[] @default([]) // frases naturais que descrevem QUANDO ativar
  instructions String   @db.Text // playbook completo (só entra no prompt quando ativada)
  examples     String?  @db.Text // few-shot examples opcionais

  relatedSkillIds String[] @default([])

  // Controle
  priority Int      @default(0) // >=100 = always-on (sempre carrega)
  tags     String[] @default([])
  isActive Boolean  @default(true)

  // Vetorização (mesma config das KBs — reaproveita provider de embedding da empresa)
  embeddingProviderId String?
  embeddingModel      String?
  qdrantPointId       String? // ID do ponto no Qdrant
  embeddingHash       String? // sha256(content) para detectar mudanças e re-indexar
  indexedAt           DateTime?

  // Stats
  hitCount  Int       @default(0)
  lastHitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   AIAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId, isActive])
  @@index([agentId, isActive])
  @@index([qdrantPointId])
  @@map("ai_agent_skills")
}

// ============================================
// AI Provider Routing — Métricas de performance por provider/modelo
// ============================================

model AIProviderMetric {
  id         String @id @default(uuid())
  companyId  String
  providerId String
  model      String

  // Contadores (janela deslizante — últimas 24h)
  totalCalls   Int @default(0)
  successCalls Int @default(0)
  errorCalls   Int @default(0)
  timeoutCalls Int @default(0)

  // Latência (ms)
  avgLatencyMs Float @default(0)
  p95LatencyMs Float @default(0)
  minLatencyMs Float @default(0)
  maxLatencyMs Float @default(0)

  // Custo
  avgCostPerCall Float @default(0) // USD
  totalCostUsd   Float @default(0)

  // Qualidade
  avgTokensPerCall Float @default(0)
  errorRate        Float @default(0) // 0-1

  // Janela temporal
  windowStart DateTime
  windowEnd   DateTime

  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([companyId, providerId, model, windowStart])
  @@index([companyId, model])
  @@map("ai_provider_metrics")
}

// ============================================
// AI Memory — Memória persistente por contato/agente
// ============================================

model AIMemory {
  id        String @id @default(uuid())
  companyId String
  agentId   String
  remoteJid String // Contato

  // Conteúdo da memória
  summary     String @db.Text // Resumo consolidado
  facts       Json? // Fatos extraídos: [{key, value, confidence, source}]
  preferences Json? // Preferências detectadas: [{topic, preference}]

  // Controle
  sessionCount  Int     @default(0) // Sessões que contribuíram
  lastSessionId String? // Última sessão que atualizou
  tokensUsed    Int     @default(0) // Tokens gastos para gerar memórias

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, agentId, remoteJid])
  @@index([agentId, remoteJid])
  @@map("ai_memories")
}

// ============================================
// AI Agent Learning — 3ª camada de memória (procedural / "lições aprendidas")
// Diferente de AIMemory (por contato) e AIBrainFact (grafo), AIAgentLearning
// guarda padrões/regras que o agente descobre na prática:
//   "Quando o cliente perguntar X, fazer Y antes de responder."
//   "Erro comum: assumir que o pedido é para retirada — sempre confirmar."
// É injetado no system prompt como bloco "lições aprendidas".
// ============================================
model AIAgentLearning {
  id        String @id @default(uuid())
  companyId String
  agentId   String

  // Conteúdo
  trigger    String  @db.Text // Quando aplicar (ex: "cliente pergunta sobre prazo de entrega")
  lesson     String  @db.Text // O que fazer/evitar (ex: "Sempre confirmar CEP antes de cotar")
  category   String  @default("general") // general | error_avoidance | optimization | policy
  confidence Float   @default(0.7) // 0-1; ajustada por feedback positivo/negativo

  // Métricas de uso (para ranking e poda)
  appliedCount  Int @default(0) // Quantas vezes foi usado
  positiveCount Int @default(0) // Feedback positivo (humano ou auto-detectado)
  negativeCount Int @default(0) // Feedback negativo

  // Origem
  sourceType  String  @default("agent_self_reflection") // agent_self_reflection | human_feedback | post_mortem
  sourceRefId String? // ID da operação/sessão que originou
  createdBy   String? // userId quem aprovou (se humano)

  // Status
  active     Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([companyId, agentId, active])
  @@index([agentId, confidence])
  @@map("ai_agent_learnings")
}

// ============================================
// AI Artifact — Outputs versionáveis de agentes
// Quando agente gera relatório, código, contrato, tabela, etc., salva como
// artefato persistente (não fica apenas no histórico de mensagens). Permite
// revisar, editar, versionar e reusar.
// ============================================
model AIArtifact {
  id        String @id @default(uuid())
  companyId String

  // Origem
  agentId   String?
  sessionId String? // AISession se veio de conversa
  remoteJid String? // contato dono
  createdByUserId String?

  // Conteúdo
  name        String
  description String? @db.Text
  type        String // markdown | json | html | table | code | image_url | pdf_url | other
  mimeType    String? // text/markdown, application/json, etc.
  content     String  @db.Text // o conteúdo em si (texto/JSON serializado/URL)
  metadata    Json? // dados estruturados extras (schema, language, etc.)

  // Versionamento
  version       Int    @default(1)
  parentArtifactId String? // se for nova versão de um anterior

  // Status
  status     String    @default("draft") // draft | approved | archived
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent  AIArtifact?  @relation("ArtifactVersions", fields: [parentArtifactId], references: [id], onDelete: SetNull)
  versions AIArtifact[] @relation("ArtifactVersions")

  @@index([companyId, agentId, createdAt])
  @@index([companyId, remoteJid])
  @@index([sessionId])
  @@index([type, status])
  @@map("ai_artifacts")
}

// ============================================
// Fleet Critic Review — registros do "Raven" (pré-mortem adversarial)
// Antes de Fleet executar uma operação destrutiva/grande, um sub-agente crítico
// analisa riscos e perspectivas. Resultado fica salvo para auditoria/melhoria.
// ============================================
model FleetCriticReview {
  id          String  @id @default(uuid())
  companyId   String
  operationId String  @unique // a FleetOperation analisada

  // Análise
  riskLevel   String   // low | medium | high | critical
  risks       Json     // [{title, severity, mitigation}]
  perspectives Json    // [{role: "executor"|"stakeholder"|"skeptic", concern}]
  recommendation String  // proceed | proceed_with_caution | block | request_approval
  rationale   String   @db.Text

  // Decisão final
  bypassedBy   String? // userId que ignorou a recomendação
  bypassedAt   DateTime?
  bypassReason String?  @db.Text

  // Métricas
  tokensInput  Int @default(0)
  tokensOutput Int @default(0)
  durationMs   Int?

  createdAt DateTime @default(now())

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operation FleetOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([companyId, riskLevel, createdAt])
  @@map("fleet_critic_reviews")
}

// ============================================
// AI MCP Server — Configuração de servidores MCP por empresa
// ============================================

model AIMCPServer {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  description String?
  serverUrl   String // URL do servidor MCP (SSE ou Streamable HTTP)
  transport   String  @default("sse") // "sse" | "streamable_http"

  // Autenticação
  authType  String  @default("none") // "none", "bearer", "header", "query"
  authKey   String? // Header name ou query param name
  authValue String? // Token/valor de autenticação

  // Configuração
  timeout        Int     @default(30000) // Timeout em ms
  sseReadTimeout Int     @default(60000) // SSE read timeout
  isActive       Boolean @default(true)

  // Ferramentas descobertas (cache)
  discoveredTools  Json? // [{name, description, inputSchema}]
  lastDiscoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("ai_mcp_servers")
}

